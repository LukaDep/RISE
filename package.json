{
    "name": "rise.client",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "tailwind": "tailwindcss -i ./src/Rise.Client/wwwroot/css/tailwind.css -o ./src/Rise.Client/wwwroot/css/output.css --watch",
        "client": "dotnet watch run --project ./src/Rise.Client/Rise.Client.csproj",
        "server-dev": "dotnet watch --project ./src/Rise.Server/Rise.Server.csproj --launch-profile Development",
        "server-prod": "dotnet run --project ./src/Rise.Server/Rise.Server.csproj --launch-profile Production",
        "dev": "concurrently \"npm run tailwind\" \"npm run server-dev\"",
        "prod": "concurrently \"npm run tailwind\" \"npm run server-prod\"",
        "prepare": "husky",
        "format:dotnet": "dotnet format",
        "format:prettier": "prettier --write .",
        "migrate": "rimraf ./src/Rise.Persistence/Migrations/ && dotnet ef migrations add initialMigration --startup-project ./src/Rise.Server/Rise.Server.csproj --project ./src/Rise.Persistence/Rise.Persistence.csproj && dotnet ef database update --project ./src/Rise.Persistence/Rise.Persistence.csproj --startup-project ./src/Rise.Server/Rise.Server.csproj",
        "docker": "docker compose down -v && docker compose up -d"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "commonjs",
    "devDependencies": {
        "@tailwindcss/cli": "^4.1.14",
        "concurrently": "^9.2.1",
        "husky": "^9.1.7",
        "prettier": "^3.6.2",
        "prettier-plugin-tailwindcss": "^0.7.0"
    },
    "dependencies": {
        "gridstack": "^12.3.3",
        "rimraf": "^6.1.2"
    }
}
