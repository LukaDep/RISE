@using System.Collections.Generic
@if (isVisible)
{
    <div class="bg-white shadow-sm border rounded-2xl p-4 mb-3 transition-all hover:shadow-md">
        <div class="flex justify-between items-center cursor-pointer" @onclick="ToggleOpen">
            <h2 class="font-semibold text-lg">@Name</h2>
            @if (IsOpen)
            {
                <i class="fa-solid fa-chevron-up"></i>
            }
            else
            {
                <i class="fa-solid fa-chevron-down"></i>
            }
        </div>

        @if (IsOpen)
        {
            <div class="mt-3 text-sm text-gray-600 space-y-2">
                <button class="px-3 py-1 bg-blue-600 text-white rounded hover:bg-blue-700 transition" @onclick="GoToPlan">
                    Campus map
                </button>
                <p><span class="font-medium">Locatie:</span> @Location</p>
                @if (Faculties != null && Faculties.Count > 0)
                {
                    <p class="font-medium">Faculteiten:</p>
                    <ul class="list-disc list-inside ml-4">
                        @foreach (var faculty in Faculties)
                        {
                            <li>@faculty</li>
                        }
                    </ul>
                }
                @if (!string.IsNullOrWhiteSpace(ContactPhone))
                {
                    <p><span class="font-medium">Telefoon:</span> @ContactPhone</p>
                }
                @if (!string.IsNullOrWhiteSpace(Website))
                {
                    <p><span class="font-medium">Website:</span> <a href="@Website" class="text-blue-500 hover:underline"
                            target="_blank">@Website</a></p>
                }
                @if (!string.IsNullOrWhiteSpace(Description))
                {
                    <p><span class="font-medium">Beschrijving:</span> @Description</p>
                }
            </div>
        }
    </div>
}