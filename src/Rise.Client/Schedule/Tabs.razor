@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web

@* Tabs container component. Child `Tab` components register themselves via CascadingParameter *@
<CascadingValue Value="this">
    <div class="rounded-lg p-2">
        <div class="flex gap-2 bg-hogent-black-15 p-1 rounded-full justify-center" role="tablist"
            aria-label="Schedule view tabs">
            @foreach (var tab in TabItems)
            {
                var isActive = tab == ActiveTab;
                <button
                    class="rounded-full w-full px-4 py-2 font-semibold focus:outline-none @(isActive ? "bg-hogent-white text-hogent-black shadow" : "text-hogent-black-50")"
                    role="tab" aria-selected="@(isActive)" @onclick="() => Activate(tab)">
                    @tab.Title
                </button>
            }
        </div>

        <div class="mt-3 bg-hogent-white p-3 rounded-lg min-h-[180px]">
            @if (ActiveTab != null)
            {
                @ActiveTab.ChildContent
            }
        </div>

        @* Render child Tab components so they can initialize and register themselves *@
        @ChildContent
    </div>
</CascadingValue>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    internal List<Tab> TabItems { get; } = new List<Tab>();

    private Tab? ActiveTab { get; set; }

    internal void AddTab(Tab tab)
    {
        if (!TabItems.Contains(tab))
            TabItems.Add(tab);

        if (ActiveTab == null)
            ActiveTab = tab;

        StateHasChanged();
    }

    private void Activate(Tab tab)
    {
        ActiveTab = tab;
    }
}