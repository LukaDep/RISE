@page "/schedule"
@using Rise.Shared.Schedule
@using Rise.Shared.Common
@using Rise.Client.Schedule
@using Rise.Client.Components

<PageTitle>@L["Schedule.Title"]</PageTitle>

<BasePage Title="@L["Schedule.Title"]">
    <Tabs @ref="TabsRef">
        <Tab Title="@L["Schedule.Day"]">
            <DayView @ref="DayViewRef" SelectedDate="@SelectedDay" OnDateChanged="date => SelectedDay = date" />
        </Tab>

        <Tab Title="@L["Schedule.Week"]">
            <WeekView SelectedDate="@SelectedDay" OnDayClick="GoToDay" OnDateChanged="date => SelectedDay = date" />
        </Tab>

        <Tab Title="@L["Schedule.Month"]">
            <MonthView SelectedDate="@SelectedDay" OnDayClick="GoToDay" OnDateChanged="date => SelectedDay = date" />
        </Tab>
    </Tabs>
</BasePage>

@code {
    private DayView? DayViewRef;
    private Tabs? TabsRef;
    private DateTime SelectedDay = DateTime.Today;

    private void GoToDay(DateTime day)
    {
        SelectedDay = day;
        TabsRef?.ActivateTab(L["Schedule.Day"]);
    }
}