@page "/schedule"
@using Rise.Shared.Schedule
@using Rise.Shared.Common
@using Rise.Client.Schedule
@inject IStringLocalizer<SharedResources> L

<div class="p-6">
    <h2 class="text-2xl font-semibold text-hogent-black mb-4">@L["Schedule.Title"]</h2>

    <Tabs @ref="TabsRef">
        <!-- Dagweergave -->
        <Tab Title="@L["Schedule.Day"]">
            <DayView @ref="DayViewRef" SelectedDate="@SelectedDay" />
        </Tab>

        <!-- Weekweergave -->
        <Tab Title="@L["Schedule.Week"]">
            <WeekView SelectedDate="@SelectedDay"
                      OnDayClick="GoToDay" />
        </Tab>

        <!-- Maandweergave -->
        <Tab Title="@L["Schedule.Month"]">
            <MonthView SelectedDate="@SelectedDay"
                       OnDayClick="GoToDay" />
        </Tab>
    </Tabs>
</div>

@code {
    private DayView? DayViewRef;
    private Tabs? TabsRef;
    private DateTime SelectedDay = DateTime.Today;

    private void GoToDay(DateTime day)
    {
        SelectedDay = day;
        TabsRef?.ActivateTab(L["Schedule.Day"]);
    }
}
