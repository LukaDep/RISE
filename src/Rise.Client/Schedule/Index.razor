@page "/schedule"
@inject IStringLocalizer<SharedResources> L
@using Rise.Client.Schedule

<PageTitle>Schedule</PageTitle>
<div class="mt-10">


  <Tabs>
    <Tab Title="@L["Schedule.Day"]">
      <DayView />
    </Tab>

    <Tab Title="@L["Schedule.Week"]">
      <WeekView />
    </Tab>

    <Tab Title="@L["Schedule.Month"]">
      <MonthView />
    </Tab>
  </Tabs>
</div>