@page "/schedule"
@page "/schedule/{date:datetime}"
@attribute [Authorize]
@using Rise.Client.Schedule.Component
@using Rise.Shared.Schedule
@using Rise.Shared.Common
@using Rise.Client.Schedule
@using Rise.Client.Components

<PageTitle>@L["Schedule.Title"]</PageTitle>

<Schedule SelectedDate="@SelectedDay" OnDayClick="GoToDay" OnDateChanged="date => SelectedDay = date" />

@code {
    [Parameter] public DateTime? date { get; set; }
    private DateTime SelectedDay = DateTime.Today;
    protected override void OnParametersSet()
    {
        if (date.HasValue)
            SelectedDay = date.Value;
    }
    private void GoToDay(DateTime day)
    {
        SelectedDay = day;
    }
}