@using Microsoft.AspNetCore.Components
@inject IStringLocalizer<SharedResources> L

<div class="week-view">
    <div class="mb-4 flex justify-between items-center">
        <h3 class="text-lg font-semibold text-hogent-black">@WeekStartDate.ToString("d MMM") @L["Schedule.To"]</h3>
        <div class="flex gap-2">
            <button class="px-3 py-1 text-sm bg-hogent-black-15 hover:bg-hogent-black-30 rounded-md"
                @onclick="PreviousWeek">@L["Schedule.Previous"]</button>
            <button class="px-3 py-1 text-sm bg-hogent-black-15 hover:bg-hogent-black-30 rounded-md"
                @onclick="NextWeek">@L["Schedule.Next"]</button>
        </div>
    </div>

    <div class="bg-hogent-white rounded-lg border border-hogent-black-30 overflow-visible">
        <!-- Header met dagen -->
        <div class="grid border-b border-hogent-black-30" style="grid-template-columns: 48px repeat(5, 1fr);">
            <div class="flex justify-center items-center border-r border-hogent-black-30 text-hogent-black-50 p-2 text-sm font-medium">@WeekNumber</div>
            @for (int i = 0; i < WeekDays.Count; i++)
            {
                var day = WeekDays[i];
                <div
                    class="p-3 text-center font-medium text-hogent-black-50 @(i < WeekDays.Count - 1 ? "border-r border-hogent-black-30" : "")">
                    <div class="text-sm">@GetLocalizedDayName(day)</div>
                    <div class="text-xs">@day.ToString("d/M")</div>
                </div>
            }
        </div>

        <!-- Grid container met relative positioning -->
        <div class="relative" style="min-height: 780px;">
            <div class="grid" style="grid-template-columns: 48px repeat(5, 1fr);">
                <!-- Tijd kolom -->
                <div class="border-r border-hogent-black-15">
                    @for (int hour = 8; hour <= 20; hour++)
                    {
                        <div
                            class="h-16 border-b border-hogent-black-15 p-1 text-center text-sm text-hogent-black-50 flex items-center justify-center">
                            @hour
                        </div>
                    }
                </div>

                <!-- Dag kolommen (lege cellen voor grid structuur) -->
                @for (int dayIndex = 0; dayIndex < WeekDays.Count; dayIndex++)
                {
                    <div class="@(dayIndex < WeekDays.Count - 1 ? "border-r border-hogent-black-30" : "")">
                        @for (int hour = 8; hour <= 20; hour++)
                        {
                            <div class="h-16 border-b border-hogent-black-15"></div>
                        }
                    </div>
                }
            </div>

            <!-- Absolute positioned events -->
            @for (int dayIndex = 0; dayIndex < WeekDays.Count; dayIndex++)
            {
                var currentDay = WeekDays[dayIndex];
                var dayEvents = GetReservationsForDate(currentDay);

                @foreach (var evt in dayEvents)
                {
                    var startHour = evt.StartDateTime.Hour;
                    var startMinute = evt.StartDateTime.Minute;
                    var endHour = evt.EndDateTime.Hour;
                    var endMinute = evt.EndDateTime.Minute;

                    // Bereken positie en hoogte in pixels (64px per uur)
                    var topPosition = ((startHour - 8) * 64) + ((startMinute * 64) / 60);
                    var durationMinutes = (endHour - startHour) * 60 + (endMinute - startMinute);
                    var height = (durationMinutes * 64) / 60;

                    // Bereken horizontale positie
                    // Time column is 48px, each day column is (100% - 48px) / 5
                    var leftPosition = $"calc(48px + {dayIndex} * ((100% - 48px) / 5) + 6px)";
                    var widthCalc = "calc(((100% - 48px) / 5) - 12px)";

                    var bgColor = GetEventTypeBgColor(evt.WorkForm);

                    <div class="absolute @bgColor rounded-lg p-2.5 shadow-md border border-white/20 overflow-hidden cursor-pointer hover:opacity-90 transition"
                        style="top: @(topPosition + 4)px; left: @leftPosition; height: @(height - 8)px; width: @widthCalc;"
                        @onclick="() => OpenDetails(evt)">
                        <div class="font-semibold text-xs leading-tight mb-0.5">@evt.Course</div>
                        <div class="text-xs opacity-90">@evt.Room</div>
                        @if (durationMinutes >= 90)
                        {
                            <div class="text-xs opacity-75 mt-1">@evt.Teacher</div>
                        }
                    </div>
                }
            }
        </div>
    </div>
    @if (SelectedReservation is not null)
    {
        <ScheduleItem Reservation="SelectedReservation" OnClose="CloseDetails" />
    }
</div>