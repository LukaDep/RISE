@using Microsoft.AspNetCore.Components
@inject IStringLocalizer<SharedResources> L

<div class="week-view">
    <div class="mb-4 flex justify-between items-center">
        <h3 class="text-lg font-semibold text-hogent-black">@L["Schedule.Week"] @WeekNumber - @WeekStartDate.ToString("d MMM") @L["Schedule.To"]
            @WeekEndDate.ToString("d MMM yyyy")</h3>
        <div class="flex gap-2">
            <button class="px-3 py-1 text-sm bg-hogent-black-15 hover:bg-hogent-black-30 rounded-md"
                @onclick="PreviousWeek">@L["Schedule.Previous"]</button>
            <button class="px-3 py-1 text-sm bg-hogent-black-15 hover:bg-hogent-black-30 rounded-md"
                @onclick="NextWeek">@L["Schedule.Next"]</button>
        </div>
    </div>

    <div class="bg-hogent-white rounded-lg border border-hogent-black-30 overflow-hidden">
        <!-- Header met dagen -->
        <div class="grid grid-cols-6 border-b border-hogent-black-30">
            <div class="p-3 text-center font-medium text-hogent-black-50 border-r border-hogent-black-30">@L["Schedule.Time"]</div>
            @{
                for (int i = 0; i < WeekDays.Count; i++)
                {
                    var day = WeekDays[i];
                    <div
                        class="p-3 text-center font-medium text-hogent-black-50 @(i < WeekDays.Count - 1 ? "border-r border-hogent-black-30" : "")">
                        <div class="text-sm">@day.ToString("ddd")</div>
                        <div class="text-xs text-hogent-black-30">@day.ToString("d/M")</div>
                    </div>
                }
            }
        </div>

        <!-- Tijdslots 8-21 uur -->
        @for (int hour = 8; hour <= 20; hour++)
        {
            <div class="grid grid-cols-6 border-b border-hogent-black-15 min-h-[60px]">
                <!-- Tijd kolom -->
                <div
                    class="p-2 text-center text-sm text-hogent-black-50 border-r border-hogent-black-30 bg-hogent-black-15 flex items-center justify-center">
                    @($"{hour:00}:00")
                </div>

                <!-- Dag kolommen -->
                @{
                    for (int dayIndex = 0; dayIndex < WeekDays.Count; dayIndex++)
                    {
                        var currentDay = WeekDays[dayIndex];
                        var hasEvent = HasEventAtTime(currentDay, hour);
                        var eventInfo = GetEventAtTime(currentDay, hour);

                        <div
                            class="p-2 border-r border-hogent-black-15 @(dayIndex == WeekDays.Count - 1 ? "" : "border-r-hogent-black-30") relative">
                            @if (hasEvent && eventInfo != null)
                            {
                                var bgColor = GetEventTypeBgColor(eventInfo.WorkForm);
                                <div class="@bgColor rounded p-1 text-xs">
                                    <div class="font-medium">@eventInfo.Course</div>
                                    <div>@eventInfo.Room</div>
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        }
    </div>
</div>