@using Microsoft.AspNetCore.Components
@using Rise.Client.Schedule
@inject IStringLocalizer<SharedResources> L
@inject NavigationManager Navigation

<div id="monthViewContainer" class="month-view min-h-screen flex flex-col @swipeClass">
    <!-- Header and navigation -->
    <div class="mb-4 flex items-center justify-between">
        <!-- Vorige maand -->
        <button class="px-3 py-1 text-sm bg-hogent-black-15 hover:bg-hogent-black-30 rounded-md flex items-center justify-center"
                @onclick="PreviousMonthAnimated">
            <span class="hidden sm:inline">@L["Schedule.Previous"]</span>
            <span class="sm:hidden w-4 h-4">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
                    <path d="M9.4 233.4c-12.5 12.5-12.5 32.8 0 45.3l160 160c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L109.3 288 480 288c17.7 0 32-14.3 32-32s-14.3-32-32-32l-370.7 0 105.4-105.4c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0l-160 160z" />
                </svg>
            </span>
        </button>

        <div class="flex-1 text-center">
            <span class="text-lg font-semibold text-hogent-black">
                @SelectedDate.ToString("MMMM yyyy", System.Globalization.CultureInfo.CurrentCulture)
            </span>
        </div>

        <button class="px-3 py-1 text-sm bg-hogent-black-15 hover:bg-hogent-black-30 rounded-md flex items-center justify-center"
                @onclick="NextMonthAnimated">
            <span class="hidden sm:inline">@L["Schedule.Next"]</span>
            <span class="sm:hidden w-4 h-4">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
                    <path d="M502.6 278.6c12.5-12.5 12.5-32.8 0-45.3l-160-160c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3L402.7 224 32 224c-17.7 0-32 14.3-32 32s14.3 32 32 32l370.7 0-105.4 105.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0l160-160z" />
                </svg>
            </span>
        </button>
    </div>

    <!-- Vandaag-knop -->
    <div class="flex justify-center mb-4">
        <button class="flex items-center gap-2 px-4 py-1.5 text-sm font-semibold text-hogent-black bg-white/60 backdrop-blur-sm
                       hover:bg-white hover:shadow-md active:scale-95 border border-hogent-black-20 rounded-full transition-all"
                @onclick="GoToToday">
            <svg class="w-4 h-4 opacity-80" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19 4h-1V2a1 1 0 0 0-2 0v2H8V2a1 1 0 0 0-2 0v2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 16H5V9h14v11z" />
            </svg>
            <span>@L["Schedule.ToToday"]</span>
        </button>
    </div>

    <!-- Calendar grid -->
    <div class="grid grid-cols-7 gap-1">
        @foreach (var day in MonthDays)
        {
            var isCurrentMonth = day.Month == SelectedDate.Month;
            var isToday = day.Date == DateTime.Today.Date;
            var hasEvents = HasEventsOnDay(day);

            <div class="border border-hogent-black-30 rounded-lg p-2 min-h-[80px] 
                        cursor-pointer transition hover:shadow-md hover:bg-hogent-black-10 
                        @(isToday ? "bg-hogent-education-15 border-hogent-education"
                                  : isCurrentMonth ? "bg-hogent-white" 
                                                   : "bg-hogent-black-15")"
                 @onclick="() => GoToDayView(day)">

                <div class="text-sm @(isCurrentMonth ? "text-hogent-black font-medium" : "text-hogent-black-30") mb-1">
                    @day.Day
                </div>

                @if (hasEvents && isCurrentMonth)
                {
                    var dayReservations = GetReservationsForDate(day);
                    <div class="space-y-1">
                        @foreach (var reservation in dayReservations.Take(3))
                        {
                            var bgColor = GetEventTypeBgColor(reservation.WorkForm);
                            <div class="w-full h-1 @bgColor rounded"></div>
                        }
                        @if (dayReservations.Count > 3)
                        {
                            <div class="text-[10px] text-hogent-black-50">
                                +@(dayReservations.Count - 3) @L["Schedule.More"]
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>

    <!-- Legend -->
    <div class="mt-4 flex gap-4 text-xs text-hogent-black-50">
        <div class="flex items-center gap-1">
            <div class="w-3 h-1 bg-blue-400 rounded"></div>
            <span>@L["Schedule.ActiveLecture"]</span>
        </div>
        <div class="flex items-center gap-1">
            <div class="w-3 h-1 bg-green-400 rounded"></div>
            <span>@L["Schedule.Practicum"]</span>
        </div>
        <div class="flex items-center gap-1">
            <div class="w-3 h-1 bg-orange-400 rounded"></div>
            <span>@L["Schedule.Seminar"]</span>
        </div>
    </div>
</div>
