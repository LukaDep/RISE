@using Rise.Shared.Campus
@using Rise.Shared.Schedule
@namespace Rise.Client.Schedule
@inject NavigationManager Navigation
@inject ICampusService CampusClientService

@if (Reservation is not null)
{
    <div class="fixed inset-0 bg-black/50 flex items-center justify-center z-50" @onclick="CloseDetails">
        <div class="relative bg-hogent-white border border-hogent-black-30 rounded-lg w-[90%] sm:w-[32rem] p-6 font-montserrat text-hogent-black shadow-lg animate-fadeIn"
            @onclick:stopPropagation>

            <div class="flex items-start gap-4">
                <div
                    class="w-20 h-20 flex flex-col items-center justify-center bg-hogent-black-15 border border-hogent-black-30 rounded-lg text-center flex-shrink-0">
                    <p class="text-3xl font-extrabold text-hogent-black leading-none">@Reservation.StartDateTime.Day</p>
                    <p class="text-xs text-hogent-black-50 font-semibold uppercase">
                        @Reservation.StartDateTime.ToString("MMM")</p>
                </div>

                <div class="flex flex-col space-y-2 flex-1">
                    <h2 class="text-xl font-semibold text-hogent-black">@Reservation.Course</h2>
                    <p class="text-hogent-black-50 text-sm">
                        @(Reservation.StartDateTime.ToString("HH:mm")) – @(Reservation.EndDateTime.ToString("HH:mm"))
                    </p>

                    <div class="text-sm text-hogent-black-70 space-y-1">
                        <p>
                            <span class="font-semibold text-hogent-black">@L["Schedule.Room"]</span>
                            <a href="javascript:void(0)" class="underline text-hogent-blue hover:text-hogent-blue-50"
                                @onclick="NavigateToRoom">
                                @Reservation.Room
                            </a>
                        </p>
                        <p><span class="font-semibold text-hogent-black">@L["Schedule.Teacher"]</span> @Reservation.Teacher
                        </p>
                    </div>

                    <div class="mt-2 space-y-1 text-sm text-hogent-black-70">
                        <p><span class="font-semibold text-hogent-black">@L["Schedule.Type"]</span> @Reservation.WorkForm
                        </p>
                        <p><span class="font-semibold text-hogent-black">@L["Schedule.Environment"]</span>
                            @Reservation.Environment</p>
                        @if (Reservation.IsAbsent)
                        {
                            <p class="text-hogent-it font-semibold">
                                @L["Schedule.Absent"]
                            </p>
                        }
                    </div>
                </div>

            </div>

            <div class="mt-6 flex justify-center">
                <button
                    class="bg-hogent-black-15 hover:bg-hogent-black-30 text-hogent-black font-semibold px-8 py-2 rounded-full transition-colors duration-200"
                    @onclick="CloseDetails">
                    @L["Schedule.Close"]
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public ScheduleDto.Reservation? Reservation { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private async Task CloseDetails()
    {
        await OnClose.InvokeAsync();
    }


    private async Task NavigateToRoom()
    {
        var buildingCode = Reservation?.Room?.Substring(0, Reservation?.Room?.IndexOf('.') ?? 0) ?? "";
        var response = await CampusClientService.GetBuildingByBuildingCodeAsync(buildingCode);
        var campusId = response.Value?.Building.CampusId.ToString() ?? "";
        Navigation.NavigateTo($"/campus-plan/{campusId}#building-{buildingCode}");
    }
}