@using System
@inject IStringLocalizer<SharedResources> L

<!-- Simpele testknop in de overview -->
<button class="bg-hogent-biotechnology-industrial_science-technology text-hogent-white font-semibold px-6 py-3 rounded-lg hover:bg-hogent-biotechnology-industrial_science-technology-50 transition-colors duration-200"
        @onclick="ShowDetails">
    @L["Schedule.Test"]
</button>

@if (ShowPopup)
{
    <!-- Overlay -->
    <div class="fixed inset-0 bg-black/50 flex items-center justify-center z-50" @onclick="CloseDetails">
        <!-- Modal -->
        <div class="relative bg-hogent-white border border-hogent-biotechnology-industrial_science-technology rounded-2xl w-[90%] sm:w-[32rem] p-8 font-montserrat text-hogent-black animate-fadeIn"
             @onclick:stopPropagation>

            <!-- Layout met datumvierkant en details -->
            <div class="flex items-start gap-5">
                <!-- Datum vierkant -->
                <div class="w-20 h-20 flex flex-col items-center justify-center bg-hogent-biotechnology-industrial_science-technology-15 border border-hogent-biotechnology-industrial_science-technology rounded-xl text-center flex-shrink-0">
                    <p class="text-4xl font-extrabold text-hogent-black leading-none">@StartDateTime.Day</p>
                    <p class="text-xs text-hogent-black-50 uppercase">@StartDateTime.ToString("MMM")</p>
                </div>

                <!-- Rechterkolom met info -->
                <div class="flex flex-col space-y-2">
                    <h2 class="text-2xl font-extrabold text-hogent-black tracking-tight">@Title</h2>
                    <p class="text-hogent-black-50 text-sm">@StartDateTime.ToString("HH:mm") – @EndDateTime.ToString("HH:mm")</p>

                    <!-- Campus + Lokaal bij elkaar -->
                    <div class="text-sm text-hogent-black-50">
                        <p><span class="font-semibold text-hogent-biotechnology-industrial_science-technology"></span>@L["Schedule.Campus"] @Campus</p>
                        <p><span class="font-semibold text-hogent-biotechnology-industrial_science-technology"></span> @string.Join(", ", Classrooms)</p>
                    </div>

                    <!-- Overige info -->
                    <div class="mt-3 space-y-1 text-sm text-hogent-black">
                        <p><span class="font-semibold text-hogent-biotechnology-industrial_science-technology">@L["Schedule.Type"]:</span> @Type</p>
                        <p><span class="font-semibold text-hogent-biotechnology-industrial_science-technology">@L["Schedule.Course"]:</span> @Course</p>
                        <p><span class="font-semibold text-hogent-biotechnology-industrial_science-technology">@L["Schedule.Note"]:</span> @Note</p>
                    </div>
                </div>
            </div>

            <!-- Sluitknop -->
            <div class="mt-8 flex justify-center">
                <button class="bg-hogent-biotechnology-industrial_science-technology text-hogent-white font-semibold px-8 py-2 rounded-full hover:bg-hogent-biotechnology-industrial_science-technology-50 transition-colors duration-200"
                        @onclick="CloseDetails">
                    @L["Schedule.Close"]
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public DateTime StartDateTime { get; set; }
    [Parameter] public DateTime EndDateTime { get; set; }
    [Parameter] public string? Type { get; set; }
    [Parameter] public string? Note { get; set; }
    [Parameter] public string? Course { get; set; }
    [Parameter] public string? Campus { get; set; }
    [Parameter] public List<string> Classrooms { get; set; } = new();

    private bool ShowPopup { get; set; }

    private void ShowDetails() => ShowPopup = true;
    private void CloseDetails() => ShowPopup = false;
}
