@using Rise.Shared.Campus
@using Rise.Shared.Schedule
@namespace Rise.Client.Schedule
@inject IStringLocalizer<SharedResources> L
@inject NavigationManager Navigation
@inject ICampusService CampusClientService

@if (Reservation is not null)
{
    <div class="fixed inset-0 bg-black/50 flex items-center justify-center z-50" @onclick="CloseDetails">
        <div class="relative bg-white border @(Reservation.IsAbsent ? "border-hogent-it-50" : "border-[#16B0A5]") rounded-2xl w-[90%] sm:w-[32rem] p-8 font-montserrat text-gray-800 animate-fadeIn"
             @onclick:stopPropagation>

            <div class="flex items-start gap-5">
                <div
                    class="w-20 h-20 flex flex-col items-center justify-center bg-[#E5FFFB] border border-[#16B0A5] rounded-xl text-center flex-shrink-0">
                    <p class="text-4xl font-extrabold text-black leading-none">@Reservation.StartDateTime.Day</p>
                    <p class="text-xs text-gray-600 uppercase">@Reservation.StartDateTime.ToString("MMM")</p>
                </div>

                <div class="flex flex-col space-y-2">
                    <h2 class="text-2xl font-extrabold text-[#000] tracking-tight">@Reservation.Course</h2>
                    <p class="text-gray-700 text-sm">
                        @(Reservation.StartDateTime.ToString("HH:mm")) – @(Reservation.EndDateTime.ToString("HH:mm"))
                    </p>

                    <div class="text-sm text-gray-700">
                        <p>
                            <span class="font-semibold text-[#16B0A5]">Lokaal:</span>
                            <a href="javascript:void(0)" class="underline text-[#16B0A5] hover:text-[#0e7c73]"
                                @onclick="NavigateToRoom">
                                @Reservation.Room
                            </a>
                        </p>
                        <p><span class="font-semibold text-[#16B0A5]">Docent:</span> @Reservation.Teacher</p>
                    </div>

    <div class="mt-3 space-y-1 text-sm text-gray-800">
        <p><span class="font-semibold text-[#16B0A5]">Type:</span> @Reservation.WorkForm</p>
        <p><span class="font-semibold text-[#16B0A5]">Omgeving:</span> @Reservation.Environment</p>
        @if (Reservation.IsAbsent)
        {
            <p class="text-hogent-it font-semibold">
                @L["Schedule.Absent"]
            </p>
        }
    </div>
</div>

            </div>

            <div class="mt-8 flex justify-center">
                <button
                    class="bg-hogent-biotechnology-industrial_science-technology text-hogent-white font-semibold px-8 py-2 rounded-full hover:bg-hogent-biotechnology-industrial_science-technology-50 transition-colors duration-200"
                    @onclick="CloseDetails">
                    @L["Schedule.Close"]
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public ScheduleDto.Reservation? Reservation { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private async Task CloseDetails()
    {
        await OnClose.InvokeAsync();
    }


    private async Task NavigateToRoom()
    {
        var buildingId = Reservation?.Room?.Substring(0, Reservation?.Room?.IndexOf('.') ?? 0) ?? "";
        var response = await CampusClientService.GetBuildingByIdAsync(buildingId);
        var campusId = response?.Value?.CampusId ?? "";
        Navigation.NavigateTo($"/campus-plan/{campusId}#building-{buildingId}");
    }
}