@using System

<!-- Simpele testknop in de overview -->
<button class="bg-[#16B0A5] text-white font-semibold px-6 py-3 rounded-lg hover:bg-[#13998e] transition-colors duration-200"
        @onclick="ShowDetails">
    Test
</button>

@if (ShowPopup)
{
    <!-- Overlay -->
    <div class="fixed inset-0 bg-black/50 flex items-center justify-center z-50" @onclick="CloseDetails">
        <!-- Modal -->
        <div class="relative bg-white border border-[#16B0A5] rounded-2xl w-[90%] sm:w-[32rem] p-8 font-montserrat text-gray-800 animate-fadeIn"
             @onclick:stopPropagation>

            <!-- Layout met datumvierkant en details -->
            <div class="flex items-start gap-5">
                <!-- Datum vierkant -->
                <div class="w-20 h-20 flex flex-col items-center justify-center bg-[#E5FFFB] border border-[#16B0A5] rounded-xl text-center flex-shrink-0">
                    <p class="text-4xl font-extrabold text-black leading-none">@StartDateTime.Day</p>
                    <p class="text-xs text-gray-600 uppercase">@StartDateTime.ToString("MMM")</p>
                </div>

                <!-- Rechterkolom met info -->
                <div class="flex flex-col space-y-2">
                    <h2 class="text-2xl font-extrabold text-[#000] tracking-tight">@Title</h2>
                    <p class="text-gray-700 text-sm">@StartDateTime.ToString("HH:mm") – @EndDateTime.ToString("HH:mm")</p>

                    <!-- Campus + Lokaal bij elkaar -->
                    <div class="text-sm text-gray-700">
                        <p><span class="font-semibold text-[#16B0A5]"></span>Campus @Campus</p>
                        <p><span class="font-semibold text-[#16B0A5]"></span> @string.Join(", ", Classrooms)</p>
                    </div>

                    <!-- Overige info -->
                    <div class="mt-3 space-y-1 text-sm text-gray-800">
                        <p><span class="font-semibold text-[#16B0A5]">Type:</span> @Type</p>
                        <p><span class="font-semibold text-[#16B0A5]">Cursus:</span> @Course</p>
                        <p><span class="font-semibold text-[#16B0A5]">Notitie:</span> @Note</p>
                    </div>
                </div>
            </div>

            <!-- Sluitknop -->
            <div class="mt-8 flex justify-center">
                <button class="bg-[#16B0A5] text-white font-semibold px-8 py-2 rounded-full hover:bg-[#13998e] transition-colors duration-200"
                        @onclick="CloseDetails">
                    Sluiten
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public DateTime StartDateTime { get; set; }
    [Parameter] public DateTime EndDateTime { get; set; }
    [Parameter] public string? Type { get; set; }
    [Parameter] public string? Note { get; set; }
    [Parameter] public string? Course { get; set; }
    [Parameter] public string? Campus { get; set; }
    [Parameter] public List<string> Classrooms { get; set; } = new();

    private bool ShowPopup { get; set; }

    private void ShowDetails() => ShowPopup = true;
    private void CloseDetails() => ShowPopup = false;
}
