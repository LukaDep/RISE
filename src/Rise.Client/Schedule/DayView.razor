@using Microsoft.AspNetCore.Components
@inject IStringLocalizer<SharedResources> L

<div id="dayViewContainer" class="day-view min-h-screen flex flex-col @swipeClass">
    <div class="mb-4 flex items-center justify-between">
        <!-- Previous Day -->
        <button class="px-3 py-1 text-sm bg-hogent-black-15 hover:bg-hogent-black-30 rounded-md flex items-center justify-center"
                @onclick="PreviousDayAnimated">
            <span class="hidden sm:inline">@L["Schedule.Previous"]</span>
            <span class="sm:hidden w-4 h-4">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
                    <path d="M9.4 233.4c-12.5 12.5-12.5 32.8 0 45.3l160 160c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L109.3 288 480 288c17.7 0 32-14.3 32-32s-14.3-32-32-32l-370.7 0 105.4-105.4c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0l-160 160z"/>
                </svg>
            </span>
        </button>

        <!-- Selected Date / Today -->
        <div class="flex-1 text-center">
            @if (SelectedDate.Date == DateTime.Today)
            {
                <span class="text-lg font-semibold text-hogent-black">@L["Schedule.Today"]</span>
            }
            else
            {
                <span class="text-lg font-semibold text-hogent-black">
                    @SelectedDate.ToString("dddd, d MMM", System.Globalization.CultureInfo.CurrentCulture)
                </span>
            }
        </div>

        <!-- Next Day -->
        <button class="px-3 py-1 text-sm bg-hogent-black-15 hover:bg-hogent-black-30 rounded-md flex items-center justify-center"
                @onclick="NextDayAnimated">
            <span class="hidden sm:inline">@L["Schedule.Next"]</span>
            <span class="sm:hidden w-4 h-4">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
                    <path d="M502.6 278.6c12.5-12.5 12.5-32.8 0-45.3l-160-160c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3L402.7 224 32 224c-17.7 0-32 14.3-32 32s14.3 32 32 32l370.7 0-105.4 105.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0l160-160z"/>
                </svg>
            </span>
        </button>
    </div>

    @if (SelectedDate.Date != DateTime.Today)
    {
        <div class="flex justify-center mb-4">
            <button class="flex items-center gap-2 px-4 py-1.5 text-sm font-semibold text-hogent-black bg-white/60 backdrop-blur-sm
                           hover:bg-white hover:shadow-md active:scale-95 border border-hogent-black-20 rounded-full transition-all"
                    @onclick="GoToToday">
                <svg class="w-4 h-4 opacity-80" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M19 4h-1V2a1 1 0 0 0-2 0v2H8V2a1 1 0 0 0-2 0v2H5a2 2 0 0 0-2 2v14a2 
                             2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 16H5V9h14v11z" />
                </svg>
                <span>@L["Schedule.ToToday"]</span>
            </button>
        </div>
    }

    @if (DayReservations.Any())
    {
        <div class="space-y-3">
            @foreach (var reservation in DayReservations.OrderBy(r => r.StartDateTime))
            {
                var startTime = reservation.StartDateTime;
                var endTime = reservation.EndDateTime;
                var borderColor = reservation.IsAbsent ? "border-hogent-it" : GetEventTypeBorderColor(reservation.WorkForm);
                var bgColor = GetEventTypeBgColor(reservation.WorkForm);

                <div class="@(reservation.IsAbsent ? "bg-hogent-it-15" : "bg-white") rounded-lg p-4 border-l-4 @borderColor shadow-sm border border-gray-100 hover:shadow-md cursor-pointer transition-all"
                    @onclick="@(() => OpenDetails(reservation))">
                    <div class="flex justify-between items-start mb-3">
                        <div class="text-sm font-medium text-hogent-black-50">
                            @startTime.ToString("HH:mm") - @endTime.ToString("HH:mm")
                        </div>
                        <span class="px-2 py-1 text-xs rounded-full @bgColor">
                            @reservation.WorkForm
                        </span>
                    </div>
                    <div class="text-base font-semibold text-hogent-black mb-2">@reservation.Course</div>
                    <div class="flex flex-wrap gap-4 text-sm text-hogent-black-50">
                        <span class="flex items-center gap-1">📍 @reservation.Room</span>
                        <span class="flex items-center gap-1">👨‍🏫 @reservation.Teacher</span>
                        @if (!string.IsNullOrEmpty(reservation.Environment))
                        {
                            <span class="flex items-center gap-1">💻 @reservation.Environment</span>
                        }
                        @if (reservation.IsAbsent)
                        {
                            <div class="flex items-center gap-1 ">
                                <i class="fa-solid fa-user-slash "></i>
                                <span class="text-hogent-it">@L["Schedule.Absent"]</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-12 text-hogent-black-50">
            <div class="text-lg mb-2">🎉</div>
            <p>@L["Schedule.NoClassesToday"]</p>
        </div>
    }
</div>

@if (SelectedReservation is not null)
{
    <ScheduleItem Reservation="SelectedReservation" OnClose="CloseDetails" />
}