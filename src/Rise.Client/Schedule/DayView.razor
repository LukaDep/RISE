@using Microsoft.AspNetCore.Components

<div id="dayViewContainer" class="day-view min-h-screen flex flex-col @swipeClass">
    <div class="mb-4 flex items-center justify-between">
        <button class="px-3 py-1 text-sm bg-hogent-black-15 hover:bg-hogent-black-30 rounded-md flex items-center justify-center"
                @onclick="PreviousDayAnimated">
            <span class="hidden sm:inline">@L["Schedule.Previous"]</span>
            <span class="sm:hidden w-4 h-4">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
                    <path d="M9.4 233.4c-12.5 12.5-12.5 32.8 0 45.3l160 160c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L109.3 288 480 288c17.7 0 32-14.3 32-32s-14.3-32-32-32l-370.7 0 105.4-105.4c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0l-160 160z"/>
                </svg>
            </span>
        </button>

        <div class="flex-1 text-center">
            @if (SelectedDate.Date == DateTime.Today)
            {
                <span class="text-lg font-semibold text-hogent-black">@L["Schedule.Today"]</span>
            }
            else
            {
                <span class="text-lg font-semibold text-hogent-black">
                    @SelectedDate.ToString("dddd, d MMM", System.Globalization.CultureInfo.CurrentCulture)
                </span>
            }
        </div>

        <button class="px-3 py-1 text-sm bg-hogent-black-15 hover:bg-hogent-black-30 rounded-md flex items-center justify-center"
                @onclick="NextDayAnimated">
            <span class="hidden sm:inline">@L["Schedule.Next"]</span>
            <span class="sm:hidden w-4 h-4">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
                    <path d="M502.6 278.6c12.5-12.5 12.5-32.8 0-45.3l-160-160c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3L402.7 224 32 224c-17.7 0-32 14.3-32 32s14.3 32 32 32l370.7 0-105.4 105.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0l160-160z"/>
                </svg>
            </span>
        </button>
    </div>

    @if (SelectedDate.Date != DateTime.Today)
    {
        <div class="flex justify-center mb-4">
            <button class="flex items-center gap-2 px-4 py-1.5 text-sm font-semibold text-hogent-black bg-white/60 backdrop-blur-sm
                           hover:bg-white hover:shadow-md active:scale-95 border border-hogent-black-20 rounded-full transition-all"
                    @onclick="GoToToday">
                <svg class="w-4 h-4 opacity-80" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M19 4h-1V2a1 1 0 0 0-2 0v2H8V2a1 1 0 0 0-2 0v2H5a2 2 0 0 0-2 2v14a2 
                             2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 16H5V9h14v11z" />
                </svg>
                <span>@L["Schedule.ToToday"]</span>
            </button>
        </div>
    }

    <div class="bg-hogent-white rounded-lg border border-hogent-black-30 overflow-visible">
        <div class="grid border-b border-hogent-black-30" style="grid-template-columns: 64px 1fr;">
            <div class="flex justify-center items-center border-r border-hogent-black-30 text-hogent-black-50 p-3 text-sm font-medium">
                @SelectedDate.ToString("ddd", System.Globalization.CultureInfo.CurrentCulture)
            </div>
            <div class="p-3 text-center font-medium text-hogent-black-50">
                <div class="text-sm">@SelectedDate.ToString("d MMMM yyyy", System.Globalization.CultureInfo.CurrentCulture)</div>
            </div>
        </div>

        <div class="relative" style="min-height: 780px;">
            <div class="grid" style="grid-template-columns: 64px 1fr;">
                <div class="border-r border-hogent-black-15">
                    @for (int hour = 8; hour <= 20; hour++)
                    {
                        <div class="h-16 border-b border-hogent-black-15 p-1 text-center text-sm text-hogent-black-50 flex items-center justify-center">
                            @hour:00
                        </div>
                    }
                </div>

                <div>
                    @for (int hour = 8; hour <= 20; hour++)
                    {
                        <div class="h-16 border-b border-hogent-black-15"></div>
                    }
                </div>
            </div>

            @foreach (var evt in DaySchedules)
            {
                var startHour = evt.StartDateTime.Hour;
                var startMinute = evt.StartDateTime.Minute;
                var endHour = evt.EndDateTime.Hour;
                var endMinute = evt.EndDateTime.Minute;

                var topPosition = ((startHour - 8) * 64) + ((startMinute * 64) / 60);
                var durationMinutes = (endHour - startHour) * 60 + (endMinute - startMinute);
                var height = (durationMinutes * 64) / 60;

                var leftPosition = "calc(64px + 8px)";
                var widthCalc = "calc(100% - 64px - 16px)";

                var bgColor = GetEventTypeBgColor(evt.WorkForm);

                <div class="absolute @bgColor rounded-lg p-3 shadow-md border border-white/20 overflow-hidden cursor-pointer hover:opacity-90 transition"
                     style="top: @(topPosition + 4)px; left: @leftPosition; height: @(height - 8)px; width: @widthCalc;"
                     @onclick="() => OpenDetails(evt)">
                    <div class="font-semibold text-sm leading-tight mb-1">@evt.Course</div>
                    <div class="text-xs opacity-90 mb-1">@evt.Room</div>
                    @if (durationMinutes >= 60)
                    {
                        <div class="text-xs opacity-75">@evt.Teacher</div>
                    }
                    @if (!string.IsNullOrEmpty(evt.Environment) && durationMinutes >= 90)
                    {
                        <div class="text-xs opacity-75 mt-1">@evt.Environment</div>
                    }
                    @if (evt.IsAbsent)
                    {
                        <div class="absolute inset-0 z-10 pointer-events-none rounded-lg bg-[repeating-linear-gradient(135deg,rgba(220,38,38,0.08)_0_12px,transparent_12px_24px)]">
                        </div>
                    }
                </div>
            }

            @{
                var timePosition = GetCurrentTimePosition();
                
                if (timePosition >= 0 && IsToday())
                {
                    <div class="absolute z-50 pointer-events-none" style="top: @(timePosition.ToString().Replace(',', '.'))px; left: 64px; width: calc(100% - 64px);">
                        <div class="relative h-0.5 bg-red-500 shadow-lg">
                            <div class="absolute -left-1 -top-1 w-2.5 h-2.5 bg-red-500 rounded-full"></div>
                            <div class="absolute -left-16 -top-2.5 bg-red-500 text-white text-xs font-semibold px-2 py-0.5 rounded shadow-md whitespace-nowrap">
                                @currentTime.ToString("HH:mm")
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

    </div>
</div>

@if (SelectedSchedule is not null)
{
    <ScheduleItem Schedule="SelectedSchedule" OnClose="CloseDetails" />
}