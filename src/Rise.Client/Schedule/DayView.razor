@using Microsoft.AspNetCore.Components
@inject IStringLocalizer<SharedResources> L

<div class="day-view">
    <div class="mb-4 flex justify-between items-center">
        <h3 class="text-lg font-semibold text-hogent-black">@SelectedDate.ToString("dddd, d MMMM yyyy")</h3>
        <div class="flex gap-2">
            <button class="px-3 py-1 text-sm bg-hogent-black-15 hover:bg-hogent-black-30 rounded-md"
                @onclick="PreviousDay">@L["Schedule.Previous"]</button>
            <button class="px-3 py-1 text-sm bg-hogent-black-15 hover:bg-hogent-black-30 rounded-md"
                @onclick="NextDay">@L["Schedule.Next"]</button>
        </div>
    </div>

    @if (DayReservations.Any())
    {
        <div class="space-y-3">
            @foreach (var reservation in DayReservations.OrderBy(r => r.StartDateTime))
            {
                var startTime = reservation.StartDateTime;
                var endTime = reservation.EndDateTime;
                var borderColor = GetEventTypeColor(reservation.WorkForm);
                var bgColor = GetEventTypeBgColor(reservation.WorkForm);

                <div class="bg-hogent-white rounded-lg p-4 border-l-4 @borderColor shadow-sm border border-hogent-black-15">
                    <div class="flex justify-between items-start mb-3">
                        <div class="text-sm font-medium text-hogent-black-50">
                            @startTime.ToString("HH:mm") - @endTime.ToString("HH:mm")
                        </div>
                        <span class="px-2 py-1 text-xs rounded-full @bgColor">
                            @reservation.WorkForm
                        </span>
                    </div>
                    <div class="text-base font-semibold text-hogent-black mb-2">@reservation.Course</div>
                    <div class="flex flex-wrap gap-4 text-sm text-hogent-black-50">
                        <span class="flex items-center gap-1">
                            📍 @reservation.Room
                        </span>
                        <span class="flex items-center gap-1">
                            👨‍🏫 @reservation.Teacher
                        </span>
                        @if (!string.IsNullOrEmpty(reservation.Environment))
                        {
                            <span class="flex items-center gap-1">
                                💻 @reservation.Environment
                            </span>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-12 text-hogent-black-50">
            <div class="text-lg mb-2">🎉</div>
            <p>@L["Schedule.NoClassesToday"]</p>
        </div>
    }
</div>