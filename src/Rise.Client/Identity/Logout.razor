@page "/logout"

<PageTitle>@L["Auth.LogoutTitle"]</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="alert alert-info">@L["Auth.LoggingOut"]</div>
    </Authorized>
    <NotAuthorized>
        <div class="alert alert-success">@L["Auth.Redirecting"]</div>
    </NotAuthorized>
</AuthorizeView>