@using Rise.Client.Components

<div class="min-h-screen bg-gray-50 pb-8">
  <div class="sticky top-0 z-40 bg-white border-b border-gray-200">
    <div class="flex items-center gap-3 px-4 py-4">
      @LeftHeaderContent
      <div class="flex items-center justify-between gap-3 flex-1">
        <h1 class="text-xl font-semibold text-black">@Title</h1>
        @HeaderContent
      </div>
    </div>
  </div>

  <div class="mx-auto px-4 pt-6 space-y-4">
    @ChildContent
  </div>
</div>