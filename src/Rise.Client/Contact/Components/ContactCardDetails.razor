@using System.Collections.Generic
@using Rise.Client.Contact.Components.Common
@inject IStringLocalizer<SharedResources> L   

<div class="bg-hogent-black-40/60 fixed inset-0 z-50 flex items-center justify-center backdrop-blur-sm">
    <div class="animate-fade-in-up border-hogent-black-15 bg-hogent-white relative max-h-[90vh] w-11/12 max-w-lg rounded-2xl border-2 p-6 shadow-2xl"
         @onclick:stopPropagation>

        <!-- Close Button -->
        <button class="text-hogent-black-50 absolute top-3 right-4 text-xl hover:text-hogent-black"
                @onclick="OnClose">
            X
        </button>

        <!-- Profile Header -->
        <div class="mb-6 flex flex-col items-center justify-center text-center">
            <div class="bg-hogent-black-15 mb-3 flex h-14 w-14 items-center justify-center rounded-lg">
                <Icon Type="@Type" />
            </div>
            <h3 class="text-hogent-black text-xl font-semibold">@Name</h3>
            <p class="text-hogent-black-50 text-sm">@Type</p>
        </div>

        <!-- Divider -->
        <div class="border-hogent-black-15 mb-4 border-t"></div>

        <!-- Contact Info Section -->
        <div class="text-hogent-black space-y-3">
            @if (@ContactPerson != null)
            {
                <div class="flex items-center gap-2 font-medium">
                    <i class="fa fa-user text-hogent-black-50"></i>
                    <span>@ContactPerson</span>
                </div>
            }

            @if (@PhoneNumber != null)
            {
                <div class="flex items-center gap-2 font-medium">
                    <i class="fa fa-phone text-hogent-black-50"></i>
                    <a href="tel:@PhoneNumber" class="text-hogent-education-100 hover:underline">@PhoneNumber</a>
                </div>
            }

            @if (@Email != null)
            {
                <div class="flex items-center gap-2 font-medium">
                    <i class="fa fa-envelope text-hogent-black-50"></i>
                    <a href="mailto:@Email" class="text-hogent-education-100 hover:underline">@Email</a>
                </div>
            }
        </div>
    </div>
</div>
