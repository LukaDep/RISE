@page "/contact"
@using Rise.Client.Contact.Components
@using Rise.Client.Components
@inject IStringLocalizer<SharedResources> L

<div class="flex items-center justify-between p-6">
    
    <!-- Title -->
    <h3 class="text-4xl font-bold">@L["Contact.Title"]</h3>

</div>
<div>
@if (contacts == null || !contacts.Any())
{
    <p>@L["Contact.Loading"]</p>
}
else
{
    <FilterLabels 
        Filters=types
    />
    @foreach (var contact in contacts)
    {
        <ContactCard 
            Id="@contact.Id"
            Name="@contact.Name" 
            Type="@contact.Type"
            Email="@contact.Email" 
            PhoneNumber="@contact.PhoneNumber" 
           
        />
    }
    
}
</div>