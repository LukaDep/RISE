@page "/contact"
@using Rise.Client.Contact.Components
@using Rise.Client.Components
@inject IStringLocalizer<SharedResources> L

<div class="flex items-center justify-between p-6">

    <!-- Title -->
    <h3 class="text-4xl font-bold">@L["Contact.Title"]</h3>

</div>
<div>
@if (contacts == null || !contacts.Any())
{
        <div class="flex justify-center items-center h-64">
            <LoadingComponent Item="@L["Contact.Loading"]" />
            </div>
        }
        else
        {
            <FilterLabels 
                Filters=types
            />
            @foreach (var contact in contacts)
            {
                        <ContactCard 
                            Id="@contact.Id.ToString()" Name="@contact.Name" Type="@contact.Type" Email="@contact.Email"
                    PhoneNumber="@contact.PhoneNumber" OnClick="() => ShowDetails(contact)" />
            }

            @if (SelectedContact != null)
            {
                <ContactCardDetails Name="@SelectedContact.Name" Type="@SelectedContact.Type" Email="@SelectedContact.Email"
                    PhoneNumber="@SelectedContact.PhoneNumber" ContactPerson="@SelectedContact.ContactPerson"
                    OnClose="CloseDetails" />
            }

            }
        </div>