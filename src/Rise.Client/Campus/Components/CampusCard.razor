@using Rise.Shared.Campus

<div class="group relative bg-white rounded-2xl shadow-md hover:shadow-2xl overflow-hidden border border-hogent-black-15 hover:border-hogent-education transition-all duration-300">
    <div class="relative h-56 overflow-hidden bg-gradient-to-br from-hogent-black to-hogent-black-30">
        <div class="w-full h-full flex items-center justify-center">
            <div class="text-center">
                <i class="fa-solid fa-map-location-dot fa-4x text-white/40 mb-4"></i>
                <p class="text-white/60 text-sm font-medium">@L["Campus.Title"]</p>
            </div>
        </div>
        
        <div class="absolute top-4 right-4">
            <span class="inline-flex items-center gap-2 px-3 py-1 bg-hogent-education text-white text-xs font-semibold rounded-full shadow-lg">
                <i class="fa-solid fa-location-dot text-sm"></i>
                @Campus.City
            </span>
        </div>
    </div>

    <div class="p-6">
        <div class="mb-4">
            <h3 class="text-2xl font-bold text-hogent-black mb-1 group-hover:text-hogent-education transition-colors">
                @Campus.Name
            </h3>
            <p class="text-hogent-black-50 text-sm">
                <i class="fa-solid fa-location-dot mr-2 text-hogent-education"></i>
                @location
            </p>
        </div>

        @if (!string.IsNullOrWhiteSpace(Campus.Description))
        {
            <p class="@(isDescriptionExpanded ? "text-hogent-black-70 text-sm mb-4" : "text-hogent-black-70 text-sm mb-4 line-clamp-2")">
                @Campus.Description
            </p>
            <button @onclick="ToggleDescription" class="text-hogent-education text-sm font-medium hover:underline mb-4">
                @(isDescriptionExpanded ? L["Campus.ReadLess"] : L["Campus.ReadMore"])
            </button>
        }

        <div class="space-y-3 mb-6 pb-6 border-b border-hogent-black-10">
            @if (!string.IsNullOrWhiteSpace(Campus.ContactPhone))
            {
                <div class="flex items-center gap-3 text-sm text-hogent-black-70 hover:text-hogent-black transition-colors">
                    <div class="w-8 h-8 rounded-lg bg-hogent-education/10 flex items-center justify-center flex-shrink-0">
                        <i class="fa-solid fa-phone text-hogent-education text-sm"></i>
                    </div>
                    <div>
                        <p class="text-xs text-hogent-black-50 font-medium">@L["Campus.ContactPhoneLabel"]</p>
                        <a href="tel:@Campus.ContactPhone" class="text-hogent-black hover:text-hogent-education transition-colors font-medium">
                            @Campus.ContactPhone
                        </a>
                    </div>
                </div>
            }
        </div>

        @if (Campus.Facilities != null && Campus.Facilities.Any())
        {
            <div class="mb-4">
                <p class="text-xs font-semibold text-hogent-black-50 uppercase tracking-wider mb-3">
                    <i class="fa-solid fa-building mr-2 text-hogent-education"></i>
                    @L["Campus.FacilitiesLabel"]
                </p>
                <div class="flex flex-wrap gap-2">
                    @foreach (var facility in Campus.Facilities)
                    {
                        <span class="inline-block px-3 py-1.5 text-xs font-semibold rounded-lg border border-hogent-education bg-hogent-education/10 text-hogent-education shadow-sm hover:bg-hogent-education/20 transition-colors">
                            <i class="fa-solid fa-check-circle mr-1 text-xs"></i>
                            @facility
                        </span>
                    }
                </div>
            </div>
        }

        <button @onclick="GoToPlan" class="w-full mt-4 px-4 py-2.5 bg-gradient-to-r from-hogent-black to-hogent-black-30 text-white font-semibold rounded-lg hover:shadow-lg transition-all duration-200 transform hover:scale-105 active:scale-95 flex items-center justify-center gap-2 group/btn">
            <i class="fa-solid fa-map text-sm group-hover/btn:translate-x-1 transition-transform"></i>
            @L["Campus.MapButton"]
        </button>
    </div>
</div>