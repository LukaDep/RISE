@page "/campus-plan/{campusId:guid}"
@layout MinimalLayout
@using Rise.Shared.Campus
@using Rise.Shared.Common
@using Rise.Client.Components

@if (@campus is null)
{
    <div class="flex justify-center items-center min-h-screen">
        <LoadingComponent Item="@L["Campus.Loading"]" />
    </div>
}
else
{
    <div id="map" class="relative h-[100vh] w-screen">
        <BackButton NavigateTo="@returnUrl" Text="@(returnUrlQuery.Contains("campus") ? L["Campus.Back"] : L["Schedule.Back"])" />
    </div>
}