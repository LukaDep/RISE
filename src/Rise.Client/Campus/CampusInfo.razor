@page "/campus"
@using Rise.Client.Campus.Components
@using Rise.Client.Components

<BasePage Title="@L["Campus.Title"]">
    <HeaderContent>
        <SearchBar Value="@SearchTerm" ValueChanged="@SearchTermChanged" />
    </HeaderContent>
    <ChildContent>
        <div class="min-h-screen bg-gradient-to-b from-hogent-white to-hogent-black-5">
            @if (campusInfo == null || !campusInfo.Any())
            {
                <div class="flex justify-center items-center h-64">
                    <LoadingComponent Item='@L["Campus.Loading"]' />
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 p-6 pb-8">
                    @foreach (var campus in campusInfo)
                    {
                        <CampusCard Campus="@campus" />
                    }
                </div>
            }
        </div>
    </ChildContent>
</BasePage>