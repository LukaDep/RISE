@page "/campus"
@using Rise.Client.Campus.Components
@using Rise.Client.Components

<BasePage Title="@L["Campus.Title"]">
    <HeaderContent>
        <SearchBar Value="@SearchTerm" ValueChanged="@SearchTermChanged" IsOpen="@isFilterOpen"
            IsOpenChanged="@((bool value) => isFilterOpen = value)" />
    </HeaderContent>
    <ChildContent>
        <div>
            @if (campusInfo == null || !campusInfo.Any())
            {
                <div class="flex justify-center items-center h-64">
                    <LoadingComponent Item='@L["Campus.Loading"]' />
                </div>
            }
            else
            {
                @foreach (var campus in campusInfo)
                {
                    var location = $"{campus.Street} {campus.HouseNumber}, {campus.PostalCode} {campus.City}";
                    <CampusCard Id="@campus.Id" Name="@campus.Name" Location="@location" Facilities="@campus.Facilities"
                        ContactPhone="@campus.ContactPhone" Description="@campus.Description" SearchTerm="@SearchTerm" />
                }
            }
        </div>
    </ChildContent>
</BasePage>