@inherits DayMenuBase

<div class="bg-white shadow-md rounded-2xl p-4 mb-6">
    <h3 class="text-lg font-bold text-gray-800 mb-3">
        📅 @Date.ToString("dddd dd MMMM yyyy")
    </h3>

    @if (MenuItems?.Any() == true)
    {
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
            @foreach (var item in MenuItems)
            {
                <div class="border border-gray-200 rounded-xl p-3 hover:shadow-lg transition">
                    <p class="font-semibold text-gray-900">@item.Name</p>
                    <p class="text-sm text-gray-600">@item.Description</p>
                    <div class="flex justify-between items-center mt-2 text-sm">
                        <span class="font-medium text-green-700">€ @item.PriceStudent</span>
                        @if (item.IsVeggie)
                        {
                            <span class="text-xs bg-green-100 text-green-700 px-2 py-1 rounded-full">Veggie</span>
                        }
                        else if (item.IsVegan)
                        {
                            <span class="text-xs bg-emerald-100 text-emerald-700 px-2 py-1 rounded-full">Vegan</span>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <p class="text-gray-500 italic">No menu items available.</p>
    }
</div>
