@using Microsoft.AspNetCore.Components.Web
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["Common.NotAuthorized"]</PageTitle>

<div class="flex flex-col items-center justify-center min-h-[60vh] px-4">
    <div class="text-center max-w-md">
        <div class="mb-6">
            <svg class="w-24 h-24 mx-auto text-hogent-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
            </svg>
        </div>
        <h1 class="text-4xl font-bold text-hogent-black mb-4">@L["Common.NotAuthorized"]</h1>
        <p class="text-lg text-hogent-black-50 mb-8">@L["Common.NotAuthorizedMessage"]</p>
        <a href="/" class="inline-block px-6 py-3 bg-hogent-black-15 hover:bg-hogent-black-30 text-hogent-black font-medium rounded-md transition-colors duration-200">
            @L["Common.BackToHome"]
        </a>
    </div>
</div>
