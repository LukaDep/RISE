@page "/counter"

<PageTitle>@L["Counter.Title"]</PageTitle>

<h1 class="title">@L["Counter.Title"]</h1>

<p role="status">@L["Counter.CurrentCount", currentCount]</p>

<button class="button mt-2" @onclick="IncrementCount">@L["Counter.ClickMe"]</button>

@code {
    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
        Log.Information("Current count {@Count}", currentCount);
    }
}