@page "/private-administrator"
@attribute [Authorize(Roles = AppRoles.Administrator)]
@using System.Security.Claims
@using Rise.Shared.Identity

<PageTitle>@L["Home.PrivateAdministratorPage"]</PageTitle>

<h1>@L["Home.PrivateAdministratorPage"]</h1>

<AuthorizeView>
    <p>@L["Home.AuthenticatedMessage", context.User.Identity?.Name ?? string.Empty] @(" ")
        <b>@L["Roles.Administrator"]</b>
    </p>
</AuthorizeView>

<h2>Claims</h2>

@if (claims.Any())
{
    <ul>
        @foreach (var claim in claims)
        {
            <li><b>@claim.Type:</b> @claim.Value</li>
        }
    </ul>
}

@code {
    private IEnumerable<Claim> claims = Enumerable.Empty<Claim>();

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthState == null)
        {
            return;
        }
        var authState = await AuthState;
        claims = authState.User.Claims;
    }
}