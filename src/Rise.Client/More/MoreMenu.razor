@using Microsoft.AspNetCore.Components
@using Rise.Client.Pages

<div class="h-full w-full bg-black text-white p-6 overflow-auto">
    <h2 class="text-lg font-bold mb-8 mt-4 text-center">Menu</h2>

    <nav class="grid grid-cols-2 gap-y-12 gap-x-6">
        <NavLink href="/resto" ActiveClass="active" @onclick="CloseMore">
            <div class="p-4 flex flex-col items-center no-underline text-hogent-black-30 [.active_&]:text-hogent-white">
                <div class="p-2 rounded-full transition-colors duration-150">
                    <i class="fa-solid fa-utensils fa-3x text-hogent-black-30 [.active_&]:text-hogent-white"></i>
                </div>
                <span class="mt-3 text-sm text-hogent-black-30 [.active_&]:text-hogent-white">Restaurants</span>
            </div>
        </NavLink>
        <AuthorizeView>
            <Authorized>
                <NavLink href="/grades" ActiveClass="active" @onclick="CloseMore">
                    <div
                        class="p-4 flex flex-col items-center no-underline text-hogent-black-30 [.active_&]:text-hogent-white">
                        <div class="p-2 rounded-full transition-colors duration-150">
                            <i
                                class="fa-solid fa-graduation-cap fa-3x text-hogent-black-30 [.active_&]:text-hogent-white"></i>
                        </div>
                        <span class="mt-3 text-sm text-hogent-black-30 [.active_&]:text-hogent-white">Grades</span>
                    </div>
                </NavLink>
            </Authorized>
        </AuthorizeView>

        <NavLink href="/news" ActiveClass="active" @onclick="CloseMore">
            <div class="p-4 flex flex-col items-center no-underline text-hogent-black-30 [.active_&]:text-hogent-white">
                <div class="p-2 rounded-full transition-colors duration-150">
                    <i class="fa-solid fa-newspaper fa-3x text-hogent-black-30 [.active_&]:text-hogent-white"></i>
                </div>
                <span class="mt-3 text-sm text-hogent-black-30 [.active_&]:text-hogent-white">News</span>
            </div>
        </NavLink>

        <NavLink href="/events" ActiveClass="active" @onclick="CloseMore">
            <div class="p-4 flex flex-col items-center no-underline text-hogent-black-30 [.active_&]:text-hogent-white">
                <div class="p-2 rounded-full transition-colors duration-150">
                    <i class="fa-solid fa-calendar-days fa-3x text-hogent-black-30 [.active_&]:text-hogent-white"></i>
                </div>
                <span class="mt-3 text-sm text-hogent-black-30 [.active_&]:text-hogent-white">Events</span>
            </div>
        </NavLink>

        <NavLink href="/campus" ActiveClass="active" @onclick="CloseMore">
            <div class="p-4 flex flex-col items-center no-underline text-hogent-black-30 [.active_&]:text-hogent-white">
                <div class="p-2 rounded-full transition-colors duration-150">
                    <i class="fa-solid fa-building fa-3x text-hogent-black-30 [.active_&]:text-hogent-white"></i>
                </div>
                <span class="mt-3 text-sm text-hogent-black-30 [.active_&]:text-hogent-white">Campus</span>
            </div>
        </NavLink>

        <NavLink href="/contact" ActiveClass="active" @onclick="CloseMore">
            <div class="p-4 flex flex-col items-center no-underline text-hogent-black-30 [.active_&]:text-hogent-white">
                <div class="p-2 rounded-full transition-colors duration-150">
                    <i class="fa-solid fa-address-book fa-3x text-hogent-black-30 [.active_&]:text-hogent-white"></i>
                </div>
                <span class="mt-3 text-sm text-hogent-black-30 [.active_&]:text-hogent-white">Contacts</span>
            </div>
        </NavLink>
        @* moet notificatie pagina komen hier ipv settings *@
        <NavLink href="/account/notificationsettings" ActiveClass="active" @onclick="CloseMore">
            <div class="p-4 flex flex-col items-center no-underline text-hogent-black-30 [.active_&]:text-hogent-white">
                <div class="p-2 rounded-full transition-colors duration-150">
                    <i class="fa-solid fa-bell fa-3x text-hogent-black-30 [.active_&]:text-hogent-white"></i>
                </div>
                <span class="mt-3 text-sm text-hogent-black-30 [.active_&]:text-hogent-white">Notifications</span>
            </div>
        </NavLink>

        <AuthorizeView>
            <Authorized>
                <NavLink href="https://ibamaflex.hogent.be/" target="_blank" rel="noopener noreferrer"
                    class="flex flex-col items-center no-underline text-hogent-black-30 p-4">
                    <div class="p-2 rounded-full">
                        <i class="fa-solid fa-user-clock fa-3x"></i>
                    </div>
                    <span class="mt-3 text-sm">Submit Absence</span>
                </NavLink>
            </Authorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    [Parameter]
    public EventCallback CloseMore { get; set; }
}