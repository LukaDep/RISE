@page "/news/{Id:guid}"
@layout MinimalLayout
@using Rise.Client.Components

<PageTitle>@newsArticle?.Title</PageTitle>

<BackButton NavigateTo="/news" Text="@L["News.Back"]" />
@if (errorMessage != null)
{
  <div class="flex justify-center items-center min-h-screen">
    <p class="text-lg text-red-500">@errorMessage</p>
  </div>
}
else if (newsArticle == null)
{
  <div class="flex justify-center items-center min-h-screen">
    <LoadingComponent Item="@L["News.Loading"]" />
    </div>
  }
  else if (newsArticle != null)
  {
    <div class=" absolute top-0 w-full">
      <div class="relative w-full h-96 mb-8">
        <img src="@GetThumbnailUrl()" alt="@newsArticle.Title" class="w-full h-full object-cover" />

        <div class="absolute inset-0 flex flex-col justify-end p-8 text-hogent-white">
          <h1 class="text-4xl md:text-5xl font-bold mb-3 leading-tight text-shadow-sm text-shadow-hogent-black">
            @newsArticle.Title
          </h1>
          <p class="text-lg md:text-xl text-shadow-sm text-shadow-hogent-black">
            @L["News.By"] @newsArticle.Author | @newsArticle.PublishDate.ToString("MMMM dd, yyyy")
          </p>
        </div>
      </div>

      <div class="max-w-4xl mx-auto px-6 md:px-8 lg:px-12 pb-12">
        <div class="prose prose-lg max-w-none">
          @newsArticle.Content
        </div>
      </div>
  </div>
}