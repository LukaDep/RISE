@page "/news"
@using Rise.Client.Components
@using Rise.Client.News.Components

<PageTitle>@L["News.Title"]</PageTitle>

<BasePage Title="@L["News.Title"]">
    <HeaderContent>
        <div class="flex flex-row gap-2">
            <SearchBar Value="@_searchTerm" ValueChanged="@SearchTermChanged" IsOpen="@_isFilterOpen"
                IsOpenChanged="@((bool value) => _isFilterOpen = value)" />
            <SimpleSelect Items="@DateRangeItems" SelectedValue="@_selectedDateRange"
                SelectedValueChanged="@OnDateRangeChanged" />
        </div>
    </HeaderContent>
    <ChildContent>
        <div id="top"></div>

        <div class="mt-4">
            @if (_news == null)
            {
                <LoadingComponent Item="@L["News.Loading"]" />
                                          }
                              else
                              {
                                  @foreach(var newsItem in _news)
                                              {
                            <NewsItem newsItem="@newsItem" />
                }

                <div class="flex flex-col items-center justify-center">
                    @if (_totalCount == 0)
                    {
                        <p class="mt-10 text-2xl">@L["News.NotFound"]</p>
                    }
                    else if (_totalCount != _currentCount)
                    {
                        <button
                            class="flex items-center justify-center gap-2 w-32 h-10 mb-2 border-2 border-hogent-black text-hogent-black rounded-2xl shadow hover:bg-hogent-blue transition disabled:opacity-50"
                            @onclick="LoadMoreNews">
                            @L["News.LoadMore"]
                            <i class="fa-solid fa-arrow-down"></i>
                        </button>
                    }

                    @if (_totalCount != 0)
                    {
                        <p class="text-hogent-black-15 mb-3">@_currentCount @L["News.Count"] @_totalCount</p>
                    }
                </div>
                }
            </div>
            <!-- scroll-to-top button: positioned above the fixed footer navbar (navbar height = 4rem) -->
            <ScrollToTop />
        </ChildContent>
    </BasePage>