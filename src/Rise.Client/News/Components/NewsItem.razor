@using Microsoft.AspNetCore.Components.Routing

<NavLink class="flex border-4 border-black/15 rounded-xl p-4 m-4 bg-white shadow transition hover:bg-black/5 cursor-pointer" href=@($"/news/{Id}") Match="NavLinkMatch.Prefix" data-news-id="@Id">
    <!-- Image placeholder -->
    <div class="w-16 h-16 bg-black/50 rounded-lg mr-4 flex-shrink-0"></div>
    <!-- Content -->
    <div class="flex-1 flex flex-col justify-center">
        <h3 class="text-lg font-bold text-black/80">@Title</h3>
        <p class="text-black/60 text-sm">@ShortDescription</p>
        <p class="text-black/40 text-xs mt-1">@Date</p>
    </div>
</NavLink>

@code {
    [Parameter]
    public string? Id { get; set; }
    [Parameter]
    public string? Title { get; set; }
    [Parameter]
    public string? ShortDescription { get; set; }

    [Parameter]
    public string? Date { get; set; }
}