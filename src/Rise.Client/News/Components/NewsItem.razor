@using Microsoft.AspNetCore.Components.Routing
@using Rise.Shared.News

<NavLink
    class="group flex flex-row items-stretch min-h-40 border border-hogent-black-15 hover:border-hogent-education rounded-xl m-4 bg-hogent-white shadow hover:shadow-lg transition cursor-pointer"
    href=@($"/news/{newsItem.Id}") Match="NavLinkMatch.Prefix" data-news-id="@newsItem.Id">
    <div class="relative w-40 flex-shrink-0 bg-gray-100 rounded-l-xl flex items-center justify-center">
        @if (!string.IsNullOrWhiteSpace(newsItem.ImageUrl))
        {
            <img src="@newsItem.ImageUrl" alt="@newsItem.Title"
                 @onload="() => _imageLoaded = true"
                 class="w-full h-full object-cover rounded-l-xl transition-opacity duration-300 @(_imageLoaded ? "opacity-100" : "opacity-0")" />

            @if (!_imageLoaded)
            {
                <div class="absolute">
                    <svg class="animate-spin h-8 w-8 text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                </div>
            }
        }
        else
        {
            <div class="w-full h-full bg-hogent-black-50 rounded-l-xl"></div>
        }
    </div>
    <div class="flex-1 flex flex-col justify-center p-3 md:ml-3 md:p-0">
        <h3 class="text-lg font-bold text-hogent-black group-hover:text-hogent-education">@newsItem.Title</h3>
        <p class="text-hogent-black-50 text-sm line-clamp-3">@newsItem.Description</p>
        <p class="text-hogent-black-30 text-xs mt-1">@newsItem.PublishDate.ToString("MMMM dd, yyyy")</p>
    </div>
</NavLink>

@code {
    [Parameter] public required NewsDto.Index newsItem { get; set; }

    private bool _imageLoaded;
}
