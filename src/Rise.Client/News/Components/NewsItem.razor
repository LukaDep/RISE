<div class="flex border-4 border-gray-500 rounded-lg p-4 m-4 bg-white shadow" data-news-id="@Id">
    <!-- Image placeholder -->
    <div class="w-16 h-16 bg-gray-200 rounded-lg mr-4 flex-shrink-0"></div>
    <!-- Content -->
    <div class="flex-1 flex flex-col justify-center">
        <h3 class="text-lg font-bold text-gray-800">@Title</h3>
        <p class="text-gray-600 text-sm">@ShortDescription</p>
        <p class="text-gray-400 text-xs mt-1">@Date</p>
    </div>
    <!-- Button -->
    <div class="flex items-center ml-4">
        <button class="bg-gray-100 hover:bg-gray-200 text-gray-800 font-medium px-4 py-2 rounded-lg transition">
            Lees meer
        </button>
    </div>
</div>

@code {
    [Parameter]
    public string Id { get; set; }
    [Parameter]
    public string Title { get; set; }
    [Parameter]
    public string ShortDescription { get; set; }

    [Parameter]
    public string Date { get; set; }
}