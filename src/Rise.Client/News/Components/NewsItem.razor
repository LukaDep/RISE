@using Microsoft.AspNetCore.Components.Routing
@using Rise.Shared.News

<NavLink
    class="group flex items-center min-h-40 border border-hogent-black-15 hover:border-hogent-education rounded-xl p-4 m-4 bg-hogent-white shadow hover:shadow-lg transition cursor-pointer"
    href=@($"/news/{newsItem.Id}") Match="NavLinkMatch.Prefix" data-news-id="@newsItem.Id">
    <!-- Image placeholder -->
    <div class="w-24 h-24 bg-hogent-black-50 rounded-lg mr-4 flex-shrink-0"></div>
    <!-- Content -->
    <div class="flex-1 flex flex-col justify-center">
        <h3 class="text-lg font-bold text-hogent-black group-hover:text-hogent-education">@newsItem.Title</h3>
        <p class="text-hogent-black-50 text-sm">@newsItem.Description</p>
        <p class="text-hogent-black-30 text-xs mt-1">@newsItem.PublishDate.ToString("MMMM dd, yyyy")</p>
    </div>
</NavLink>

@code {
    [Parameter]
    public required NewsDto.Index newsItem { get; set; }
}