@page "/{mode?}"

@using Rise.Client.Home.Components
@using Rise.Client.Home

<PageTitle>@(IsEditMode ? @L["Home.Edit"] : @L["Home.Home"])</PageTitle>

<div class="min-h-screen bg-gray-50 pb-8">
    <div
        class="flex items-center justify-between px-4 py-3 lg:pt-10 bg-white sticky top-0 z-40 border-b border-gray-200">
        <img src="/HOGENT-Logo-Home.png" alt="Hogent Logo" class="h-10 w-auto" />
        <AuthorizeView>
            <Authorized>
                <div class="flex items-center space-x-2">
                    @if (!IsEditMode)
                    {
                        <button type="button"
                            class="p-2 rounded-full bg-hogent-black text-hogent-white hover:bg-hogent-black-30 focus:outline-none"
                            @onclick="EnterEdit" aria-label="@L["Home.Edit"]">
                            <i class="fa-solid fa-pencil p-1"></i>
                        </button>
                    }
                    else
                    {
                        <div class="toolbar relative flex items-center gap-3" tabindex="0">
                            <button @onclick="() => ToggleAdd()" aria-haspopup="true" aria-expanded="@_isAddOpen"
                                aria-label="Add widget"
                                class="w-10 h-10 rounded-full bg-hogent-black-15 border border-gray-200 shadow-sm flex items-center justify-center text-2xl text-gray-700 hover:shadow-md transition-transform transform active:scale-95 focus:outline-none focus:ring-2 focus:ring-offset-1 focus:ring-gray-200">
                                <i class="fa-solid fa-plus"></i>
                            </button>

                            @if (_isAddOpen)
                            {
                                var available = AvailableWidgets.ToList();
                                <div class="absolute mt-2 top-full right-0 bg-white border border-gray-100 shadow-lg rounded-md w-48 z-99 p-1"
                                    @onfocusout="CloseAdd">
                                    <div class="px-3 py-2 text-xs text-gray-400">@L["Home.AddWidget"]</div>
                                    <div class="divide-y divide-gray-100">
                                        @if (!available.Any())
                                        {
                                            <div class="px-3 py-2 text-sm text-gray-500">@L["Home.NoMoreWidgets"]</div>
                                        }
                                        else
                                        {
                                            @foreach (var t in available)
                                            {
                                                <button
                                                    class="w-full text-left px-3 py-2 text-sm rounded-md hover:bg-gray-50 focus:outline-none flex items-center gap-2"
                                                    @onclick="() => AddWidget(t)">
                                                    <i class="fa-solid fa-plus text-gray-400"></i>
                                                    <span>@GetWidgetName(t)</span>
                                                </button>
                                            }
                                        }
                                    </div>
                                </div>
                            }
                        </div>

                        <button type="button" @onclick="SaveAndExit" aria-label="@L["Home.Save"]"
                            class="w-10 h-10 rounded-full bg-green-600 text-white shadow-md flex items-center justify-center text-lg hover:bg-green-700 active:scale-95 focus:outline-none focus:ring-2 focus:ring-offset-1 focus:ring-green-300 transition">
                            <i class="fa-solid fa-check"></i>
                        </button>
                    }
                </div>
            </Authorized>
        </AuthorizeView>
    </div>


    <MiddleElements EditMode="IsEditMode" Widgets="_currentWidgets" OnRemove="RemoveItem" />

</div>