@using Rise.Shared.Schedule
@using Rise.Client.Schedule
@namespace Rise.Client.Home.Components

@if (Reservation == null)
{
    <div class="p-4 bg-white border border-gray-200 rounded-lg shadow-sm mb-3 text-gray-500">No upcoming class</div>
}
else
{
    <div
        class="flex items-start space-x-4 p-4 rounded-lg shadow-sm mb-3 hover:shadow-md transition-shadow duration-150 @bgColor">
        <div class="flex-shrink-0 flex items-center">
            <div class="text-sm font-bold">@Reservation.StartDateTime.ToString("HH:mm")</div>
        </div>

        <div class="flex-1 min-w-0">
            <h3 class="text-base font-semibold leading-tight truncate">@Reservation.Course</h3>

            <div class="mt-2 flex flex-col text-sm gap-1">
                @if (!string.IsNullOrWhiteSpace(Reservation.Room))
                {
                    <div>@Reservation.Room</div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public ScheduleDto.Schedule? Reservation { get; set; }
    private string? bgColor => ScheduleHelpers.GetEventTypeBgColor(Reservation?.WorkForm ?? string.Empty);
}