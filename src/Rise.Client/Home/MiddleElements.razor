@namespace Rise.Client.Home
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Rendering
@using Rise.Client.Home.Components
@using Rise.Client.Home.Widgets
@using System.Linq
@using Rise.Shared.Widgets

<div class="px-1">
    <div id="@_gridId" class="grid-stack py-0">
        @for (int i = 0; i < Widgets.Count; i++)
        {
            var entry = Widgets[i];

            <div @key="entry.Id" class="grid-stack-item m-0" id="@entry.Id" gs-x="@entry.X" gs-y="@entry.Y"
                gs-w="@entry.Width" gs-h="@entry.Height" gs-min-w="@entry.MinWidth" gs-min-h="3"
                gs-max-h="@(entry.Type == typeof(Widgets.LinksWidget) ? 3 : 10)">
                <div class="grid-stack-item-content bg-white rounded-xl shadow p-3 my-4 border border-hogent-black-15">
                    <DynamicComponent Type="@entry.Type" Parameters="@GetWidgetParameters(i, entry.Id)" />
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public bool EditMode { get; set; }
    [Parameter] public EventCallback<Guid> OnRemove { get; set; }
    [Parameter] public List<WidgetEntry> Widgets { get; set; } = new();

    [Inject] public IJSRuntime Js { get; set; } = default!;

    private readonly string _gridId = "grid-home";
    private DotNetObjectReference<MiddleElements>? _dotRef;
    private bool _gridInitialized;
    private List<Guid> _lastWidgets = new();
    private int _columns = 10;

    private IDictionary<string, object> GetWidgetParameters(int index, Guid widgetId)
    => new Dictionary<string, object>
    {
{ "Index", index },
{ "WidgetId", widgetId },
{ "OnRemove", EventCallback.Factory.Create<Guid>(this, async (id) => await OnRemove.InvokeAsync(id)) },
{ "EditMode", EditMode }
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotRef = DotNetObjectReference.Create(this);
            Console.WriteLine("Initializing gridstack...");
            await Js.InvokeVoidAsync("gridstackInterop.initGrid", _gridId, new
            {
                column = _columns,
                @float = false,
                disableOneColumnMode = true,
                staticGrid = !EditMode
            }, _dotRef);
            await Js.InvokeVoidAsync("gridstackInterop.setEditMode", _gridId, EditMode);

            _gridInitialized = true;
            _lastWidgets = Widgets.Select(w => w.Id).ToList();
        }

        if (_gridInitialized)
        {
            await Task.Yield();
            await Js.InvokeVoidAsync("gridstackInterop.setEditMode", _gridId, EditMode);

            var current = Widgets.Select(w => w.Id).ToList();
            var changed = !_lastWidgets.SequenceEqual(current);
            if (changed)
            {
                try
                {
                    await Js.InvokeVoidAsync("gridstackInterop.destroy", _gridId);
                }
                catch
                {
                    // ignore
                }

                await Js.InvokeVoidAsync("gridstackInterop.initGrid", _gridId, new
                {
                    column = _columns,
                    @float = false,
                    disableOneColumnMode = true,
                    staticGrid = !EditMode
                }, _dotRef);

                _lastWidgets = current;
                _gridInitialized = true;
            }

        }
    }
}