@namespace Rise.Client.Home.Widgets
@using Rise.Shared.Common
@using Rise.Shared.News
@inject NavigationManager NavigationManager
@inject INewsService NewsClientService

<div class="flex flex-col">
    <div class="flex justify-between">
        <div class="text-sm font-semibold text-hogent-black-50 mb-1">@L["Home.LatestNews"]</div>
        @if (EditMode)
        {
            <button class="font-bold" @onclick="async () => await OnRemove.InvokeAsync(WidgetId)"
                title="Remove widget">×</button>
        }
        else
        {
            <span class="text-sm text-blue-600 cursor-pointer" @onclick="More">@L["Home.More"]</span>

        }
    </div>

    <div class="flex-1 overflow-auto">
        @if (_loading)
        {
            <div class="text-sm text-hogent-black-50">Loading…</div>
        }
        else if (!string.IsNullOrEmpty(_error))
        {
            <div class="text-sm text-red-500">@_error</div>
        }
        else if (News == null)
        {
            <div class="text-sm text-hogent-black-50">@L["Home.NoNews"]</div>
        }
        else
        {
            <span class="text-lg font-medium text-hogent-black text-medium">@News.Title</span>
            <div class="text-xs text-hogent-black-30 mt-1">@News.PublishDate.ToString("dd MMM yyyy")</div>
            <div class="text-sm text-hogent-black-30 mt-2">@News.Description
                <span class="text-blue-600 cursor-pointer underline" @onclick="ReadMore">read more</span>
            </div>
        }
    </div>
</div>