<div class="flex">
    <div>
        @if (EditMode)
        {
            <span class="drag-handle flex items-center justify-center h-7 w-5 text-hogent-black-50" title="Drag widget"
                aria-label="Drag widget">
                <i class="fa-solid fa-grip-vertical"></i>
            </span>
        }
    </div>
    <div class="flex flex-col w-full">
        <div class="flex justify-between items-center">
            <div class="text-sm font-semibold text-hogent-black-50 leading-tight">@L["Home.LatestGrades"]</div>
            @if (EditMode)
            {
                <button class="font-bold text-hogent-black-50" @onclick="async () => await OnRemove.InvokeAsync(WidgetId)"
                    title="Remove widget">×</button>
            }
            else
            {
                <button @onclick="More"
                    class="flex items-center gap-1 text-xs text-hogent-education opacity-70 hover:opacity-100 transition">
                    @L["Home.More"]
                    <span class="text-[10px]">›</span>
                </button>
            }
        </div>

        <div class="flex-1 overflow-auto mt-2">
            @if (_loading)
            {
                <div class="text-sm text-hogent-black-50">Loading…</div>
            }
            else if (!string.IsNullOrEmpty(_error))
            {
                <div class="text-sm text-red-500">@_error</div>
            }
            else if (Grade == null)
            {
                <div class="text-sm text-hogent-black-50">@L["Home.NoGrades"]</div>
            }
            else
            {
                <ul class="space-y-2">
                    @if (Grade != null)
                    {
                        <li class="flex items-center justify-between gap-3">
                            <div class="text-sm text-hogent-black leading-tight break-words">@Grade.Name</div>
                            <div class="flex-shrink-0">
                                @if (Grade.Score.HasValue)
                                {
                                    <div
                                        class="inline-flex items-center justify-center min-w-[52px] px-2 py-0.5 rounded-full border border-gray-200 bg-gray-50 text-gray-700 text-sm font-medium text-center">
                                        @String.Format("{0:0.##}", Grade.Score)
                                        <span class="mx-1">/</span>
                                        @((Grade.MaxPoints.HasValue) ? String.Format("{0:0.##}", Grade.MaxPoints) : "-")
                                    </div>
                                }
                                else
                                {
                                    <div class="text-xs text-hogent-black-50">—</div>
                                }
                            </div>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
</div>