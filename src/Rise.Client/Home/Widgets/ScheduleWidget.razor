@using Rise.Client.Home.Components

<div class="flex">
    <div>
        @if (EditMode)
        {
            <span class="drag-handle flex items-center justify-center h-7 w-5 text-hogent-black-50" title="Drag widget"
                aria-label="Drag widget">
                <i class="fa-solid fa-grip-vertical"></i>
            </span>
        }
    </div>
    <div class="flex flex-col w-full">
        <div class="flex justify-between items-center">

            @if (UpcomingClasses == null || !UpcomingClasses.Any())
            {
                <div class="text-sm font-semibold text-hogent-black-50 mb-1">@L["Home.NoClassesToday"]</div>
            }
            else
            {
                <div class="text-sm font-semibold text-hogent-black-50 mb-1">@L["Home.Today"]</div>
            }
            @if (EditMode)
            {
                <button class="font-bold text-hogent-black-50" @onclick="async () => await OnRemove.InvokeAsync(WidgetId)"
                    title="Remove widget">×</button>
            }
            else
            {
                <button @onclick="More"
                    class="flex items-center gap-1 text-xs text-hogent-education opacity-70 hover:opacity-100 transition">
                    @L["Home.More"]
                    <span class="text-[10px]">›</span>
                </button>
            }
        </div>
        <div class="flex-1 overflow-auto">
            @if (_loading)
            {
                <div class="text-sm text-hogent-black-50">Loading…</div>
            }
            else if (!string.IsNullOrEmpty(_error))
            {
                <div class="text-sm text-red-500">@_error</div>
            }
            else if (UpcomingClasses == null)
            {
                <div class="text-sm text-hogent-black-50">No upcoming classes</div>
            }
            @if (UpcomingClasses != null && UpcomingClasses.Any())
            {
                @foreach (var reservation in UpcomingClasses)
                {
                    <UpcomingClassCard Reservation="reservation" />
                }
            }

        </div>
    </div>
</div>