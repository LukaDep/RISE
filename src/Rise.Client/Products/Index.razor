@page "/product"
@using Rise.Shared.Identity

<PageTitle>@L["Products.Title"]</PageTitle>

<h1 class="title">@L["Products.Title"]</h1>

<p>@L["Products.FetchingData"]</p>

<AuthorizeView Roles="@AppRoles.Administrator">
    <div class="is-flex is-justify-content-flex-end">
        <a href="products/create" class="button is-dark">@L["Products.Create"]</a>
    </div>
</AuthorizeView>

@if (products == null)
{
    <p><em>@L["Common.Loading"]</em></p>
}
else
{
    <table class="table is-fullwidth">
        <thead>
            <tr>
                <th>@L["Products.Id"]</th>
                <th>@L["Products.Name"]</th>
                <th>@L["Products.Description"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in products)
            {
                <tr @key="product.Id">
                    <td>@product.Id</td>
                    <td>@product.Name</td>
                    <td>@product.Description</td>
                </tr>
            }
        </tbody>
    </table>
}