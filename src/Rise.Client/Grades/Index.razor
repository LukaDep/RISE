@page "/grades"
@attribute [Authorize]
@using Rise.Shared.Grades
@using Rise.Client.Grades.Components
@using Rise.Client.Components

<PageTitle>@L["Grades.Title"]</PageTitle>

<BasePage Title="@L["Grades.Title"]">
  <HeaderContent>
    <div class="flex flex-row items-center gap-3">
      <SimpleSelect Items="@YearItems" SelectedValue="@selectedYear" SelectedValueChanged="@OnYearSelected"
        Placeholder=@L["Grades.YearFilterPlaceholder"] />
      <SimpleSelect Items="@SemesterItems" SelectedValue="@(selectedSemester?.ToString())"
        SelectedValueChanged="@OnSemesterSelected" Placeholder=@L["Grades.SemesterFilterPlaceholder"] />
      <SearchBar Value="@searchTerm" ValueChanged="@OnSearchTermChanged" IsOpen="@isFilterOpen"
        IsOpenChanged="@((bool value) => isFilterOpen = value)" />
    </div>
  </HeaderContent>
  <ChildContent>
    <div id="top"></div>

    @if (!Grades.Any())
    {
      <div class="flex flex-col items-center justify-center h-64 text-hogent-black-50">
        <LoadingComponent Item="@L["Grades.Loading"]" />
      </div>
    }
    else if (!FilteredGrades.Any())
    {
      <div class="flex flex-col items-center justify-center h-64 text-hogent-black-50">
        <i class="fa-solid fa-graduation-cap fa-3x mb-4"></i>
        <p class="text-xl font-medium">@L["Grades.NoGradesFound"]</p>
        <p class="text-sm mt-2">@L["Grades.TryDifferentFilters"]</p>
      </div>
    }
    else
    {
      <div class="mb-6 p-5 bg-hogent-black rounded-2xl shadow-lg text-white">
        <div class="flex items-center justify-between mb-3">
          <h3 class="text-lg font-bold flex items-center gap-2">
            <i class="fa-solid fa-chart-simple"></i>
            @L["Grades.Overview"]
          </h3>
          <span class="text-xs bg-white/20 px-3 py-1 rounded-full">
            @FilteredGrades.Count() @L["Grades.Results"]
          </span>
        </div>
        <div class="grid grid-cols-3 gap-4">
          <div class="text-center">
            <div class="text-2xl font-bold">@GetAverageScore()</div>
            <div class="text-xs text-white/70">@L["Grades.Average"]</div>
          </div>
          <div class="text-center border-x border-white/20">
            <div class="text-2xl font-bold text-green-400">@GetPassedCount()</div>
            <div class="text-xs text-white/70">@L["Grades.Passed"]</div>
          </div>
          <div class="text-center">
            <div class="text-2xl font-bold text-red-400">@GetFailedCount()</div>
            <div class="text-xs text-white/70">@L["Grades.Failed"]</div>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 pb-8">
        @foreach (var grade in FilteredGrades)
        {
          <GradeItem Grade="grade" />
        }
      </div>
    }

    <ScrollToTop />
  </ChildContent>
</BasePage>