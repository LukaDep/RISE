@page "/grades"
@using Rise.Client.Grades
@using Rise.Client.Grades.Components
@using Rise.Shared.Grades
@using Rise.Shared.Common
<PageTitle>@L["Grades.Title"]</PageTitle>
<div class="flex justify-between items-center mx-4 mt-10">
    <h1 class="text-4xl font-bold font-montserrat">@L["Grades.Title"]</h1>
</div>
<div>
    @if (Courses == null)
    {
        <div class="flex justify-center items-center h-16 mt-16">
            <div class="animate-spin rounded-full h-8 w-8 border-t-4 border-b-4 border-b-hogent-education"></div>
        </div>
    }
    else
    {
        @foreach (var courseItem in Courses)
        {
            <CourseItem Course="@courseItem" />
        }
    }
</div>