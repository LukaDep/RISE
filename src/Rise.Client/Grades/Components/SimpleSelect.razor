@using Microsoft.AspNetCore.Components.Web
<div class="relative inline-block text-left w-37">
    <button type="button"
        class="w-full bg-hogent-white border border-hogent-black-30 text-sm px-4 py-2 pr-8 rounded-full shadow-sm text-left flex items-center justify-between hover:border-hogent-education focus:outline-none focus:ring-2 focus:ring-hogent-education"
        @onclick="Toggle" aria-haspopup="listbox" aria-expanded="@IsOpen">
        <span class="truncate">@(GetLabel(SelectedValue) ?? Placeholder)</span>
        <!-- keep the old svg pointer -->
        <svg class="ml-2 text-hogent-black-50" width="16" height="16" viewBox="0 0 24 24" fill="none"
            xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                stroke-linejoin="round" />
        </svg>
    </button>

    @if (IsOpen)
    {
        <div
            class="absolute z-50 mt-2 w-full bg-white rounded-2xl shadow-lg overflow-hidden ring-1 ring-black ring-opacity-5 transform transition ease-out duration-150 border border-hogent-black-15     ">
            <div class="max-h-56 overflow-auto py-1 pr-1 text-base divide-y divide-gray-100 simple-select-scroll"
                role="listbox" tabindex="-1">
                @for (int i = 0; i < ItemsList.Count; i++)
                {
                    var item = ItemsList[i];
                    var selected = item.Key == SelectedValue;
                    <div class="relative flex items-center justify-between cursor-pointer px-4 py-3 text-gray-900 select-none @((selected ? "bg-hogent-education-15 text-hogent-education font-semibold" : "hover:bg-hogent-education-15 hover:text-hogent-education"))"
                        role="option" aria-selected="@selected" @onclick="(() => Select(item.Key))"
                        @onmouseover="(() => Highlight(i))">
                        <div class="truncate">@item.Value</div>
                        <span class="flex items-center pr-4 text-hogent-education"
                            style="display:@(selected ? "flex" : "none")">
                            <svg viewBox="0 0 20 20" fill="currentColor" width="18" height="18" aria-hidden="true">
                                <path
                                    d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z"
                                    clip-rule="evenodd" fill-rule="evenodd" />
                            </svg>
                        </span>
                    </div>
                }
            </div>
        </div>
    }
</div>

<style>
    /* Custom scrollbar for dropdown (supported in modern browsers) */
    .simple-select-scroll::-webkit-scrollbar {
        width: 10px;
    }

    .simple-select-scroll::-webkit-scrollbar-track {
        background: transparent;
        /* keep track transparent so the thumb looks like a thin pill */
        border-radius: 9999px;
        margin: 6px 0;
        /* try to inset the track a bit so it doesn't touch corners */
    }

    .simple-select-scroll::-webkit-scrollbar-thumb {
        background-color: rgba(76, 162, 213, 0.25);
        /* hogent-education-ish */
        border-radius: 9999px;
        border: 3px solid transparent;
        /* give thumb some breathing room */
        background-clip: padding-box;
    }

    /* Firefox scrollbar styling */
    .simple-select-scroll {
        scrollbar-width: thin;
        scrollbar-color: rgba(76, 162, 213, 0.25) transparent;
        /* ensure scrollbar gutter so content doesn't shift when scrollbar appears */
        scrollbar-gutter: stable;
    }
</style>