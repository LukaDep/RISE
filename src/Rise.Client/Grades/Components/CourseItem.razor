@namespace Rise.Client.Grades.Components
@inject IStringLocalizer<SharedResources> L

<div class="items-center min-h-30 border-2 border-hogent-black-15 rounded-xl p-4 m-4 bg-hogent-white shadow transition  cursor-pointer font-montserrat"
    @onclick="HandleClick">
    <div class="flex items-center gap-3">
        <div class="flex-1">
            <div class="flex justify-between items-start">
                <div>
                    <h4 class="text-base font-semibold">@Course.CourseName</h4>
                    <div class="text-sm text-hogent-black-50">
                        @L["Course.YearSemester", Course.Year, Course.Semester]
                    </div>
                </div>

                <div class="text-right text-sm">
                    <div class="text-hogent-black"><strong>@L["Course.Final"]:</strong> <span
                            class="ml-1">@FinalScoreText</span>
                    </div>
                    <div class="text-hogent-black-50 text-xs mt-1">@TotalGradesText</div>
                </div>
            </div>

            <div class="mt-3 flex justify-between items-center gap-4 text-sm text-hogent-black-50">
                <div class="flex gap-6">
                    <div class="flex flex-col">
                        <div class="text-xs">@L["Course.Average"]</div>
                        <div>@AveragePercentageText</div>
                    </div>

                    <div class="flex flex-col">
                        <div class="text-xs">@L["Course.Submitted"]</div>
                        <div>@SubmittedText</div>
                    </div>
                </div>
                <div class="w-11 h-11 flex-none">
                    <svg width="44" height="44" viewBox="0 0 44 44" aria-hidden="true" role="img">
                        <circle cx="22" cy="22" r="18" stroke="#e6e6e6" stroke-width="4" fill="none" />
                        <circle cx="22" cy="22" r="18" stroke="#a5ca72" stroke-width="4" fill="none"
                            stroke-dasharray="@CircumferenceString" stroke-dashoffset="@StrokeDashOffsetString"
                            stroke-linecap="round" transform="rotate(-90 22 22)" />
                        <text x="22" y="26" text-anchor="middle" font-size="10" fill="#111">@SubmittedPercent%</text>
                    </svg>
                </div>
            </div>
        </div>
    </div>
</div>