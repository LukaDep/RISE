@page "/deadlines"
@using Rise.Client.Deadlines.Components
@inject IStringLocalizer<SharedResources> L
@attribute [Authorize]

<PageTitle>@L["Deadlines.Title"]</PageTitle>

<div class="flex items-center justify-between p-6">

    <!-- Title -->
    <h3 class="text-4xl font-bold">@L["Deadlines.Title"]</h3>

</div>

@if(Deadlines != null)
{
	@foreach(var deadline in Deadlines)
	{
		<DeadlineCard Deadline=deadline></DeadlineCard>
	}
}



