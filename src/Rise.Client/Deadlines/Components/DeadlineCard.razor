@using Microsoft.AspNetCore.Components.Routing
@using Rise.Shared.Deadlines
@inject IStringLocalizer<SharedResources> L

@if (IsExpired)
{
    <div class="group relative bg-white rounded-2xl border-2 border-dashed border-red-200 overflow-hidden opacity-75 hover:opacity-100 transition-all duration-200">
        <div class="absolute top-0 left-0 w-1.5 h-full bg-red-400"></div>
        <div class="p-4 pl-5">
            <div class="flex items-start justify-between gap-4">
                <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2 mb-1">
                        <span class="inline-flex items-center gap-1 px-2 py-0.5 bg-red-100 text-red-700 text-xs font-semibold rounded-full">
                            <i class="fa-solid fa-clock-rotate-left text-[10px]"></i>
                            @L["Deadlines.Expired"]
                        </span>
                    </div>
                    <h3 class="text-base font-bold text-hogent-black-50 line-through decoration-red-300 mb-1 truncate">
                        @Deadline.Title
                    </h3>
                    @if (!string.IsNullOrEmpty(Deadline.Description))
                    {
                        <p class="text-sm text-hogent-black-40 line-clamp-1 mb-2">@Deadline.Description</p>
                    }
                    <div class="flex items-center gap-3 text-xs text-hogent-black-40">
                        @if (!string.IsNullOrEmpty(Deadline.Course))
                        {
                            <span class="flex items-center gap-1">
                                <i class="fa-solid fa-book"></i>
                                @Deadline.Course
                            </span>
                        }
                        <span class="flex items-center gap-1">
                            <i class="fa-solid fa-user"></i>
                            @Deadline.Lector
                        </span>
                    </div>
                </div>
                <div class="flex flex-col items-end shrink-0">
                    <div class="text-right">
                        <p class="text-xs text-red-400 font-medium mb-0.5">@L["Deadlines.Deadline"]</p>
                        <p class="text-base font-bold text-red-500">
                            @Deadline.EndDate.ToString("dd MMM")
                        </p>
                        <p class="text-xs text-red-400">
                            @Deadline.EndDate.ToString("yyyy")
                        </p>
                    </div>
                    <div class="mt-2 px-2 py-1 bg-red-50 rounded-lg">
                        <p class="text-xs font-semibold text-red-600">
                            @{
                                var daysAgo = Math.Abs(DaysRemaining);
                                if (daysAgo == 0)
                                {
                                    @L["Deadlines.ExpiredToday"]
                                }
                                else if (daysAgo == 1)
                                {
                                    @L["Deadlines.Expired1DayAgo"]
                                }
                                else
                                {
                                    @L["Deadlines.ExpiredDaysAgo", daysAgo]
                                }
                            }
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="group relative bg-white rounded-2xl shadow-md hover:shadow-lg border border-hogent-black-15 hover:border-hogent-education overflow-hidden transition-all duration-200">
        @if (DaysRemaining <= 1)
        {
            <div class="absolute top-0 left-0 w-1.5 h-full bg-red-500"></div>
        }
        else if (DaysRemaining <= 3)
        {
            <div class="absolute top-0 left-0 w-1.5 h-full bg-orange-400"></div>
        }
        else if (DaysRemaining <= 7)
        {
            <div class="absolute top-0 left-0 w-1.5 h-full bg-yellow-400"></div>
        }
        else
        {
            <div class="absolute top-0 left-0 w-1.5 h-full bg-hogent-education"></div>
        }
        
        <div class="p-4 pl-5">
            <div class="flex items-start justify-between gap-4">
                <div class="flex-1 min-w-0">
                    <h3 class="text-base font-bold text-hogent-black group-hover:text-hogent-education mb-1 truncate transition-colors">
                        @Deadline.Title
                    </h3>
                    @if (!string.IsNullOrEmpty(Deadline.Description))
                    {
                        <p class="text-sm text-hogent-black-60 line-clamp-2 mb-2">@Deadline.Description</p>
                    }
                    <div class="flex flex-wrap items-center gap-3 text-xs text-hogent-black-50">
                        @if (!string.IsNullOrEmpty(Deadline.Course))
                        {
                            <span class="inline-flex items-center gap-1 px-2 py-0.5 bg-hogent-education/10 text-hogent-education rounded-full font-medium">
                                <i class="fa-solid fa-book text-[10px]"></i>
                                @Deadline.Course
                            </span>
                        }
                        <span class="flex items-center gap-1">
                            <i class="fa-solid fa-user text-hogent-black-30"></i>
                            @Deadline.Lector
                        </span>
                    </div>
                </div>
                <div class="flex flex-col items-end shrink-0">
                    <div class="text-right mb-2">
                        <p class="text-xs text-hogent-black-40 font-medium mb-0.5">@L["Deadlines.Deadline"]</p>
                        <p class="text-lg font-bold text-hogent-education">
                            @Deadline.EndDate.ToString("dd MMM")
                        </p>
                        <p class="text-xs text-hogent-black-40">
                            @Deadline.EndDate.ToString("yyyy")
                        </p>
                    </div>
                    @if (DaysRemaining <= 7)
                    {
                        <div class="@GetUrgencyBadgeClasses()">
                            @if (DaysRemaining == 0)
                            {
                                <i class="fa-solid fa-fire text-[10px]"></i>
                                <span>@L["Deadlines.UrgentToday"]</span>
                            }
                            else if (DaysRemaining == 1)
                            {
                                <i class="fa-solid fa-exclamation text-[10px]"></i>
                                <span>@L["Deadlines.Urgent1Day", DaysRemaining]</span>
                            }
                            else
                            {
                                <i class="fa-regular fa-clock text-[10px]"></i>
                                <span>@L["Deadlines.DaysLeft", DaysRemaining]</span>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}
