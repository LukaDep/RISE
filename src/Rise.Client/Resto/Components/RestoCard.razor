@using Rise.Shared.Resto
@inject IStringLocalizer<SharedResources> L

<div class="group relative bg-white rounded-2xl shadow-md hover:shadow-2xl overflow-hidden border border-hogent-black-15 hover:border-hogent-education">
    <div class="relative h-48 overflow-hidden bg-gradient-to-br from-hogent-education to-hogent-black-30">
        @if (!string.IsNullOrEmpty(Resto.ImageUrl))
        {
            <img src="@Resto.ImageUrl" alt="@Resto.Name" class="w-full h-full object-cover" />
        }
        else
        {
            <div class="w-full h-full flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-20 h-20 text-white opacity-50">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 8.25v-1.5m0 1.5c-1.355 0-2.697.056-4.024.166C6.845 8.51 6 9.473 6 10.608v2.513m6-4.871c1.355 0 2.697.056 4.024.166C17.155 8.51 18 9.473 18 10.608v2.513M15 8.25v-1.5m-6 1.5v-1.5m12 9.75-1.5.75a3.354 3.354 0 0 1-3 0 3.354 3.354 0 0 0-3 0 3.354 3.354 0 0 1-3 0 3.354 3.354 0 0 0-3 0 3.354 3.354 0 0 1-3 0L3 16.5m15-3.379a48.474 48.474 0 0 0-6-.371c-2.032 0-4.034.126-6 .371m12 0c.39.049.777.102 1.163.16 1.07.16 1.837 1.094 1.837 2.175v5.169c0 .621-.504 1.125-1.125 1.125H4.125A1.125 1.125 0 0 1 3 20.625v-5.17c0-1.08.768-2.014 1.837-2.174A47.78 47.78 0 0 1 6 13.12M12.265 3.11a.375.375 0 1 1-.53 0L12 2.845l.265.265Zm-3 0a.375.375 0 1 1-.53 0L9 2.845l.265.265Zm6 0a.375.375 0 1 1-.53 0L15 2.845l.265.265Z" />
                </svg>
            </div>
        }
        
        <div class="absolute top-4 right-4">
            @if (Resto.IsCurrentlyOpen)
            {
                <span class="px-3 py-1 bg-green-500 text-white text-xs font-semibold rounded-full shadow-lg flex items-center gap-1">
                    <span class="w-2 h-2 bg-white rounded-full animate-pulse"></span>
                    @L["Resto.Open"]
                </span>
            }
            else
            {
                <span class="px-3 py-1 bg-red-500 text-white text-xs font-semibold rounded-full shadow-lg">
                    @L["Resto.Closed"]
                </span>
            }
        </div>
    </div>

    <div class="p-6">
        <div class="mb-4">
            <h3 class="text-2xl font-bold text-hogent-black mb-2 group-hover:text-hogent-education ">
                @Resto.Name
            </h3>
            @if (!string.IsNullOrEmpty(Resto.KitchenType))
            {
                <span class="inline-block px-3 py-1 bg-hogent-black-15 text-hogent-black-70 text-xs font-medium rounded-full">
                    @Resto.KitchenType
                </span>
            }
        </div>

        @if (!string.IsNullOrEmpty(Resto.Description))
        {
            <p class="text-hogent-black-70 text-sm mb-4 line-clamp-2">
                @Resto.Description
            </p>
        }

        <div class="space-y-2 mb-4">
            @if (!string.IsNullOrEmpty(Resto.PhoneNumber))
            {
                <div class="flex items-center gap-2 text-sm text-hogent-black-70">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 text-hogent-education">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
                    </svg>
                    <span>@Resto.PhoneNumber</span>
                </div>
            }
            @if (!string.IsNullOrEmpty(Resto.Email))
            {
                <div class="flex items-center gap-2 text-sm text-hogent-black-70">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 text-hogent-education">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
                    </svg>
                    <span class="truncate">@Resto.Email</span>
                </div>
            }
        </div>

        <NavLink href=@($"/resto/{Resto.Id}/menu")
                 class="w-full inline-flex items-center justify-center gap-2 px-4 py-2 mb-3 text-white bg-hogent-education hover:bg-hogent-education/90 active:bg-hogent-education/90 rounded-lg shadow focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-hogent-education transition"
                 aria-label=@($"{L["Resto.ViewMenu"]} - {Resto.Name}")
                 title=@L["Resto.ViewMenu"]>
            <span class="font-semibold">@L["Resto.ViewMenu"]</span>
        </NavLink>

        @if (Resto.OpeningHours != null && Resto.OpeningHours.Any())
        {
            <button @onclick="ToggleOpeningHours" 
                    class="w-full mt-4 px-4 py-2 bg-hogent-black text-white rounded-lg hover:bg-hogent-black/90 flex items-center justify-between group/btn">
                <span class="font-semibold">@L["Resto.OpeningHours"]</span>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" 
                     class="w-5 h-5 @(showOpeningHours ? "rotate-180" : "")">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
                </svg>
            </button>

            @if (showOpeningHours)
            {
                <div class="mt-4 p-4 bg-hogent-black-5 rounded-lg space-y-2 animate-fade-in">
                    @foreach (var day in GetSortedOpeningHours())
                    {
                        <div class="flex justify-between items-center text-sm @(IsToday(day.Key) ? "font-bold text-hogent-education" : "text-hogent-black-70")">
                            <span>@GetDayName(day.Key)</span>
                            <span>@GetOpeningHoursDisplay(day.Value)</span>
                        </div>
                    }
                </div>
            }
        }
    </div>

    <div class="absolute inset-0 bg-hogent-education opacity-0 group-hover:opacity-5 pointer-events-none"></div>
</div>
