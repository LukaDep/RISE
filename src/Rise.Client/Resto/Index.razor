@page "/resto"
@using Rise.Client.Resto.Components
@using Rise.Client.Components

<PageTitle>@L["Resto.Title"]</PageTitle>

<BasePage Title="@L["Resto.Title"]">
    <HeaderContent>
        <SearchBar Value="@searchTerm" ValueChanged="@SearchTermChanged" IsOpen="@isFilterOpen"
            IsOpenChanged="@((bool value) => isFilterOpen = value)" />
    </HeaderContent>
    <ChildContent>

        @if (restos == null)
        {
            <div class="flex justify-center items-center h-64">
                <LoadingComponent Item="@L["Resto.Loading"]" />
                </div>
            }
            else if (!restos.Any())
            {
                <div class=" flex flex-col items-center justify-center h-64 text-hogent-black-50">
                    <i class="fa-solid fa-triangle-exclamation fa-3x mb-4"></i>
                    <p class="text-xl">@L["Resto.NoResults"]</p>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 pb-8">
                @foreach (var resto in restos)
                {
                    <RestoCard Resto="@resto" />
                }
            </div>
        }
    </ChildContent>
</BasePage>