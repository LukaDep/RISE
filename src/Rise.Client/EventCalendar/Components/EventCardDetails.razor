@using System.Collections.Generic
@using Rise.Client.Contact.Components.Common
@inject IStringLocalizer<SharedResources> L

<div class="bg-hogent-black-40/60 fixed inset-0 z-50 flex items-center justify-center backdrop-blur-sm">
    <div class="animate-fade-in-up border-hogent-black-15 bg-hogent-white relative max-h-[90vh] w-11/12 max-w-lg rounded-2xl border-2 p-6 shadow-2xl"
         @onclick:stopPropagation>

        <!-- Close Button -->
        <button class="text-hogent-black-50 absolute top-3 right-4 text-xl hover:text-hogent-black"
                @onclick="OnClose">
            X
        </button>

        <!-- Profile Header -->
        <div class="mb-6 flex flex-col items-center justify-center text-center">
            <h3 class="text-hogent-black text-xl font-semibold">@specificEvent.Name</h3>
            <p class="text-hogent-black-50 text-sm">@specificEvent.Type</p>
        </div>

        <!-- Divider -->
        <div class="border-hogent-black-15 mb-4 border-t"></div>

        <!-- Contact Info Section -->
        <div class="text-hogent-black space-y-3">
            @if (@specificEvent.Description != null)
            {
                <div class="flex items-start gap-2 font-medium">
                    <i class="fa fa-book text-hogent-black-50 mt-1"></i>
                    <span class="text-hogent-black">@specificEvent.Description</span>
                </div>
            }

            @if (specificEvent.StartDateTime != null && specificEvent.EndDateTime != null)
            {
                string startDateParsed = $"{specificEvent.StartDateTime:dd/MM/yyyy}";
                string startTimeParsed = $"{specificEvent.StartDateTime:HH:mm}";
                string endDateParsed = $"{specificEvent.EndDateTime:dd/MM/yyyy}";
                string endTimeParsed = $"{specificEvent.EndDateTime:HH:mm}";
                <div class="flex items-center gap-2 font-medium">
                    <i class="fas fa-clock text-hogent-black-50"></i>
                    <span class="text-hogent-black">
                        @if(startDateParsed == endDateParsed)
                        {
                            @startDateParsed
                        }
                        else
                        {
                            @(startDateParsed + " - " + endDateParsed)
                        }
                    </span>
                </div>
                <div class="flex items-center gap-2 font-medium">
                    <i class="fa fa-calendar text-hogent-black-50"></i>
                    <span class="text-hogent-black">
                        @(startTimeParsed + " - " + endTimeParsed)
                    </span>
                </div>
            }

            @if (specificEvent.RegistrationLink != null)
            {
                <div class="flex items-center gap-2 font-medium">
                    <i class="fa fa-external-link text-hogent-black-50"></i>
                    <a href=@specificEvent.RegistrationLink class="text-hogent-education-100 hover:underline">@L["EventCardDetails.register"]</a>
                </div>
            }
        </div>
    </div>
</div>
