@using Microsoft.AspNetCore.Components
@inject NavigationManager Navigation

<div id="monthViewContainer" class="month-view m-4 flex flex-col @swipeClass">
    <div class="mb-4 flex items-center justify-between">
        <button class="bg-hogent-black-15 flex items-center justify-center rounded-md px-3 py-1 text-sm hover:bg-hogent-black-30"
                @onclick="PreviousMonthAnimated">
            <span class="hidden sm:inline">@L["Schedule.Previous"]</span>
            <span class="h-4 w-4 sm:hidden">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
                    <path d="M9.4 233.4c-12.5 12.5-12.5 32.8 0 45.3l160 160c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L109.3 288 480 288c17.7 0 32-14.3 32-32s-14.3-32-32-32l-370.7 0 105.4-105.4c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0l-160 160z" />
                </svg>
            </span>
        </button>

        <div class="flex-1 text-center">
            <span class="text-hogent-black text-lg font-semibold">
                @SelectedDate.ToString("MMMM yyyy", System.Globalization.CultureInfo.CurrentCulture)
            </span>
        </div>

        <button class="bg-hogent-black-15 flex items-center justify-center rounded-md px-3 py-1 text-sm hover:bg-hogent-black-30"
                @onclick="NextMonthAnimated">
            <span class="hidden sm:inline">@L["Schedule.Next"]</span>
            <span class="h-4 w-4 sm:hidden">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
                    <path d="M502.6 278.6c12.5-12.5 12.5-32.8 0-45.3l-160-160c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3L402.7 224 32 224c-17.7 0-32 14.3-32 32s14.3 32 32 32l370.7 0-105.4 105.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0l160-160z" />
                </svg>
            </span>
        </button>
    </div>

    <div class="mb-4 flex justify-center">
        <button class="text-hogent-black border-hogent-black-20 flex items-center gap-2 rounded-full border bg-white/60 px-4 py-1.5
                       text-sm font-semibold backdrop-blur-sm transition-all hover:bg-white hover:shadow-md active:scale-95"
                @onclick="GoToToday">
            <svg class="h-4 w-4 opacity-80" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19 4h-1V2a1 1 0 0 0-2 0v2H8V2a1 1 0 0 0-2 0v2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 16H5V9h14v11z" />
            </svg>
            <span>@L["Schedule.ToToday"]</span>
        </button>
    </div>

    <div class="grid grid-cols-7 gap-1">
        @foreach (var day in MonthDays)
        {
            var isCurrentMonth = day.Month == SelectedDate.Month;
            var isToday = day.Date == DateTime.Today.Date;
            var hasEvents = HasEventsOnDay(day);

            <div class="border-hogent-black-30 min-h-[80px] cursor-pointer rounded-lg border p-2 transition hover:bg-hogent-black-10 hover:shadow-md @(isToday ? "bg-hogent-education-15 border-hogent-education"
                                  : isCurrentMonth ? "bg-hogent-white" 
                                                   : "bg-hogent-black-15")"
                 @onclick="() => GoToDayView(day)">

                <div class="mb-1 @(isCurrentMonth ? "text-hogent-black font-medium" : "text-hogent-black-30") text-sm">
                    @day.Day
                </div>

                @if (hasEvents && isCurrentMonth)
                {
                    var daySchedules = GetSchedulesForDate(day);
                    <div class="space-y-1">
                        @foreach (var schedule in daySchedules.Take(3))
                        {
                            var bgColor = GetEventTypeBgColor(schedule.Type);
                            <div class="h-1 w-full @bgColor rounded"></div>
                        }
                        @if (daySchedules.Count > 3)
                        {
                            <div class="text-hogent-black-50 text-[10px]">
                                +@(daySchedules.Count - 3) @L["Schedule.More"]
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>

    <div class="text-hogent-black-50 mt-4 flex flex-wrap gap-4 text-xs">
        @{
            var typesInMonth = GetTypesInMonth();
            foreach (var type in typesInMonth)
            {
                var bgColor = GetEventTypeBgColor(type);
        <div class="flex items-center gap-1">
                    <div class="h-1 w-3 @bgColor rounded"></div>
                    <span>@type</span>
                </div>
            }
        }
    </div>
</div>
